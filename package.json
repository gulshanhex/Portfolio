{
  "name": "gk-portfolio-astro",
  "type": "module",
  "version": "3.0.0",
  "description": "Edge-native, database-driven engineering portfolio & CMS built with Astro 5 SSR, Cloudflare Workers, and Cloudflare D1.",
  "license": "MIT",
  "author": {
    "name": "Gulshan Kumar",
    "url": "https://github.com/gulshanhex"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gulshanhex/portfolio.git"
  },
  "bugs": {
    "url": "https://github.com/gulshanhex/portfolio/issues"
  },
  "homepage": "https://github.com/gulshanhex/portfolio#readme",
  "keywords": [
    "astro",
    "cloudflare-workers",
    "cloudflare-d1",
    "portfolio",
    "cms",
    "pwa",
    "edge-ssr",
    "typescript",
    "aeo",
    "llms-txt"
  ],
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "check:admin": "node scripts/check-admin.mjs",
    "check:settings": "node scripts/check-settings-usage.mjs",
    "check:strings": "node scripts/check-hardcoded-strings.mjs",
    "check:assets": "node scripts/check-assets.mjs",
    "check": "node scripts/check-admin.mjs && node scripts/check-settings-usage.mjs && node scripts/check-hardcoded-strings.mjs && node scripts/check-assets.mjs",
    "prebuild": "node scripts/check-admin.mjs && node scripts/check-settings-usage.mjs && node scripts/check-hardcoded-strings.mjs && node scripts/check-assets.mjs && node scripts/prepare-wrangler.mjs",
    "build": "astro build",
    "preview": "astro build && wrangler dev",
    "deploy": "astro build && wrangler deploy --keep-vars",
    "cf-typegen": "wrangler types",
    "db:schema:local": "wrangler d1 execute portfolio-cms-db --local --file=./schema.sql",
    "db:seed:local": "wrangler d1 execute portfolio-cms-db --local --file=./seed.sql",
    "db:schema:remote": "wrangler d1 execute portfolio-cms-db --remote --file=./schema.sql",
    "db:seed:remote": "wrangler d1 execute portfolio-cms-db --remote --file=./seed.sql",
    "db:migrate:remote": "wrangler d1 execute portfolio-cms-db --remote --file=./migrations/0001_phase4_slugs_and_details.sql"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.0",
    "astro": "^5.12.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250214.0",
    "typescript": "^5.8.2",
    "wrangler": "^4.30.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}