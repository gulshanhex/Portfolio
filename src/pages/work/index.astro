---
import { getEnv } from '../../lib/env';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import ProjectCard from '../../components/ui/ProjectCard.astro';
import Button from '../../components/ui/Button.astro';
import { getProjects, getAllSettings } from '../../lib/db';
import { t } from '../../lib/ui-strings';

const db = getEnv()?.DB;
const projects = await getProjects(db, true);
const settings = await getAllSettings(db);

const g = settings.global || {};
const theme = settings.theme || {};
const seo = settings.seo || {};

const name = g.name || 'Your Name';
const location = g.location || 'Remote';
const defaultTheme = theme.default || 'dark';
const accent = theme.accent || 'emerald';
const glowIntensity = theme.glow_intensity || theme.neon_intensity || 'subtle';
const canonicalBase = (seo.canonical || g.portfolio || 'https://portfolio.example.com').replace(/\/$/, '');

const categories = [...new Set(projects.map((p) => p.category).filter(Boolean))];

const brandMark = t(settings, 'a11y.brand_mark');
const brandHomeAria = `${name} ${t(settings, 'a11y.brand_home_aria')}`;
const homeLabel = t(settings, 'nav.home_label');
const workLabel = t(settings, 'nav.work_label');
const ctaLabel = t(settings, 'nav.cta_label');
const archiveEyebrow = t(settings, 'work.archive_eyebrow');
const archiveTitle = t(settings, 'work.archive_title');
const archiveSubtitle = t(settings, 'work.archive_subtitle');
const filterAria = t(settings, 'projects.filter_aria');
const filterAllLabel = t(settings, 'projects.filter_all');
const emptyStateText = t(settings, 'work.empty_state');
const returnHomeBtn = t(settings, 'work.not_found_home_btn');
const footerCta = t(settings, 'work.footer_cta');

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: homeLabel, item: `${canonicalBase}/` },
    { '@type': 'ListItem', position: 2, name: workLabel, item: `${canonicalBase}/work` },
  ],
};
---

<BaseLayout
  title={`${archiveTitle} · ${name}`}
  description={archiveSubtitle}
  canonical={`${canonicalBase}/work`}
  ogTitle={`${archiveTitle} · ${name}`}
  ogDescription={archiveSubtitle}
  authorName={name}
  defaultTheme={defaultTheme}
  accent={accent}
  glowIntensity={glowIntensity}
  jsonLd={breadcrumbLd}
  settings={settings}
>
  <header class="work-header">
    <div class="work-header-inner">
      <a href="/" class="brand-logo" aria-label={brandHomeAria}>
        <span class="logo-text">{brandMark}</span><span class="logo-dot">.</span>
      </a>
      <nav class="work-nav-links" aria-label={workLabel}>
        <a href="/" class="back-link">
          <span aria-hidden="true">←</span>
          <span>{homeLabel}</span>
        </a>
        <Button variant="primary" size="sm" href="/#contact">
          {ctaLabel}
        </Button>
      </nav>
    </div>
  </header>

  <main id="main-content" class="work-main">
    <div class="work-container">
      <SectionHeader
        eyebrow={archiveEyebrow}
        title={archiveTitle}
        subtitle={archiveSubtitle}
      />

      <!-- Category Filter Pills -->
      {categories.length > 1 && (
        <div class="work-filters" role="group" aria-label={filterAria}>
          <button class="proj-filter-btn active" type="button" data-cat="all">
            <span>{filterAllLabel} ({projects.length})</span>
          </button>
          {categories.map((cat) => (
            <button class="proj-filter-btn" type="button" data-cat={cat.toLowerCase()}>
              <span>{cat}</span>
            </button>
          ))}
        </div>
      )}

      <!-- Grid -->
      {projects.length > 0 ? (
        <div class="work-grid" id="proj-grid" role="list">
          {projects.map((p, i) => (
            <div class="rv" style={`transition-delay: ${i * 0.06}s`}>
              <ProjectCard
                id={p.id}
                title={p.title}
                category={p.category}
                categoryIcon={p.category_icon}
                summary={p.summary}
                tags={p.tags || []}
                stack={p.stack || []}
                featured={Boolean(p.featured)}
                externalUrl={p.external_url || undefined}
                githubUrl={p.github_url || undefined}
                demoUrl={p.demo_url || undefined}
                slug={p.slug || undefined}
                settings={settings}
              />
            </div>
          ))}
        </div>
      ) : (
        <div class="no-projects-box">
          <p>{emptyStateText}</p>
          <Button variant="primary" size="md" href="/" class="mt-4">
            {returnHomeBtn}
          </Button>
        </div>
      )}
    </div>
  </main>

  <footer class="work-footer">
    <div class="work-footer-inner">
      <span>{name} · {location}</span>
      <a href="/#contact">{footerCta}</a>
    </div>
  </footer>

  <script is:inline>
    // Project Category Filtering for Work Archive (hides .rv grid wrapper so no empty cells remain)
    document.querySelectorAll('.proj-filter-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.proj-filter-btn').forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        const cat = (btn.getAttribute('data-cat') || 'all').toLowerCase();
        document.querySelectorAll('.project-card').forEach((card) => {
          const cardCat = (card.getAttribute('data-cat') || '').toLowerCase();
          const match = cat === 'all' || cardCat === cat;
          const wrapper = card.closest('.rv') || card;
          wrapper.style.display = match ? '' : 'none';
        });
      });
    });
  </script>
</BaseLayout>

<style>
  .work-header {
    position: sticky;
    top: 0;
    z-index: 100;
    height: var(--nav-height);
    background: rgba(10, 12, 11, 0.88);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--border);
  }

  :global([data-theme="light"]) .work-header {
    background: rgba(246, 247, 244, 0.94);
  }

  .work-header-inner {
    max-width: var(--max-w-content);
    height: 100%;
    margin: 0 auto;
    padding: 0 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .brand-logo {
    font-family: var(--ff-sans);
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--heading);
    text-decoration: none;
  }

  .logo-dot {
    color: var(--accent);
  }

  .work-nav-links {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--ff-sans);
    font-size: var(--fs-xs);
    font-weight: 500;
    color: var(--muted);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .back-link:hover {
    color: var(--heading);
  }

  .work-main {
    padding: 40px 20px 64px;
    background: var(--bg);
  }

  .work-container {
    max-width: var(--max-w-content);
    margin: 0 auto;
  }

  .work-filters {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: var(--sp-5);
  }

  .proj-filter-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 16px;
    border-radius: var(--radius-pill);
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--muted);
    font-family: var(--ff-mono);
    font-size: var(--fs-xs);
    font-weight: 500;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .proj-filter-btn:hover {
    color: var(--text);
    border-color: var(--border-subtle);
  }

  .proj-filter-btn.active {
    background: var(--accent);
    color: var(--text-on-accent);
    border-color: var(--accent);
    font-weight: 600;
  }

  .work-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }

  .no-projects-box {
    text-align: center;
    padding: var(--sp-8);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    font-family: var(--ff-sans);
    color: var(--muted);
  }

  .work-footer {
    border-top: 1px solid var(--border);
    padding: 28px 20px;
    background: var(--surface);
  }

  .work-footer-inner {
    max-width: var(--max-w-content);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-family: var(--ff-mono);
    font-size: var(--fs-xs);
    color: var(--muted);
  }

  .work-footer-inner a {
    color: var(--accent);
    text-decoration: none;
  }

  @media (min-width: 640px) {
    .work-header-inner {
      padding: 0 28px;
    }
    .work-main {
      padding: 56px 28px 72px;
    }
    .work-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 20px;
    }
    .work-footer {
      padding: 32px 28px;
    }
    .work-footer-inner {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  @media (min-width: 1024px) {
    .work-header-inner {
      padding: 0 32px;
    }
    .work-main {
      padding: 72px 32px 84px;
    }
    .work-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 24px;
    }
    .work-footer {
      padding: 36px 32px;
    }
  }
</style>
