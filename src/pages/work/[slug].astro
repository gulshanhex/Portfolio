---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/ui/Button.astro';
import Card from '../../components/ui/Card.astro';
import Pill from '../../components/ui/Pill.astro';
import Icon from '../../components/ui/Icon.astro';
import { getProjectBySlug, getAllSettings, getProjects, sanitizeBasicHtml } from '../../lib/db';
import { t } from '../../lib/ui-strings';

const { slug } = Astro.params;
const db = Astro.locals.runtime?.env?.DB;

if (!slug) {
  return Astro.redirect('/work');
}

const project = await getProjectBySlug(db, slug);

if (!project) {
  Astro.response.status = 404;
}

const settings = await getAllSettings(db);
const g = settings.global || {};
const theme = settings.theme || {};
const seo = settings.seo || {};

const name = g.name || 'Your Name';
const location = g.location || 'Remote';
const defaultTheme = theme.default || 'dark';
const accent = theme.accent || 'emerald';
const glowIntensity = theme.glow_intensity || theme.neon_intensity || 'subtle';
const canonicalBase = (seo.canonical || g.portfolio || 'https://portfolio.example.com').replace(/\/$/, '');

// Related projects
const allProjects = await getProjects(db, true);
const relatedProjects = allProjects.filter((p) => p.slug !== slug).slice(0, 3);

// UI strings
const brandMark = t(settings, 'a11y.brand_mark');
const brandHomeAria = `${name} ${t(settings, 'a11y.brand_home_aria')}`;
const homeLabel = t(settings, 'nav.home_label');
const workLabel = t(settings, 'nav.work_label');
const allWorkLabel = t(settings, 'work.detail_all_work');
const discussBtnLabel = t(settings, 'work.detail_discuss_btn');
const breadcrumbAria = t(settings, 'services.detail_breadcrumb_aria');
const featuredPill = t(settings, 'work.detail_featured_pill');
const liveDemoBtn = t(settings, 'work.detail_live_demo_btn');
const exploreBtn = t(settings, 'work.detail_explore_btn');
const githubBtn = t(settings, 'work.detail_github_btn');
const stackLabel = t(settings, 'work.detail_stack_label');
const probBadge = t(settings, 'work.detail_prob_badge');
const probHeading = t(settings, 'work.detail_prob_heading');
const probFallback = t(settings, 'work.detail_prob_fallback');
const solBadge = t(settings, 'work.detail_sol_badge');
const solHeading = t(settings, 'work.detail_sol_heading');
const solFallback = t(settings, 'work.detail_sol_fallback');
const resBadge = t(settings, 'work.detail_res_badge');
const resHeading = t(settings, 'work.detail_res_heading');
const resFallback = t(settings, 'work.detail_res_fallback');
const ctaTitle = t(settings, 'work.detail_cta_title');
const ctaDesc = t(settings, 'work.detail_cta_desc');
const ctaBtn = t(settings, 'work.detail_cta_btn');
const relatedTitle = t(settings, 'work.detail_related_title');
const readCaseStudy = t(settings, 'work.detail_read_case_study');
const backWorkLabel = t(settings, 'work.detail_back_work');

const nfEyebrow = t(settings, 'work.not_found_eyebrow');
const nfTitle = t(settings, 'work.not_found_title');
const nfDesc = t(settings, 'work.not_found_desc');
const nfAllBtn = t(settings, 'work.not_found_all_btn');
const nfHomeBtn = t(settings, 'work.not_found_home_btn');

// Breadcrumbs and SoftwareSourceCode JSON-LD
const schemaGraph = project ? {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: homeLabel, item: `${canonicalBase}/` },
        { '@type': 'ListItem', position: 2, name: workLabel, item: `${canonicalBase}/work` },
        { '@type': 'ListItem', position: 3, name: project.title, item: `${canonicalBase}/work/${slug}` },
      ],
    },
    {
      '@type': 'SoftwareSourceCode',
      name: project.title,
      description: project.summary,
      programmingLanguage: project.stack || [],
      keywords: [...(project.tags || []), ...(project.stack || [])].join(', '),
      author: {
        '@type': 'Person',
        name,
        url: canonicalBase,
      },
      ...(project.github_url ? { codeRepository: project.github_url } : {}),
    },
  ],
} : null;

const allTags = project ? Array.from(new Set([...(project.tags || []), ...(project.stack || [])])) : [];
---

{
  !project ? (
    <BaseLayout
      title={`${nfTitle} · ${name}`}
      description={nfDesc}
      robots="noindex, nofollow"
      authorName={name}
      defaultTheme={defaultTheme}
      accent={accent}
      glowIntensity={glowIntensity}
      settings={settings}
    >
      <main id="main-content" class="not-found-wrap">
        <div class="nf-eyebrow">{nfEyebrow}</div>
        <h1 class="nf-title">{nfTitle}</h1>
        <p class="nf-desc">{nfDesc}</p>
        <div class="nf-actions">
          <Button variant="primary" size="md" href="/work">
            <span>{nfAllBtn}</span>
            <span aria-hidden="true">→</span>
          </Button>
          <Button variant="secondary" size="md" href="/">
            <span>{nfHomeBtn}</span>
          </Button>
        </div>
      </main>
    </BaseLayout>
  ) : (
    <BaseLayout
      title={`${project.title} — ${name}`}
      description={project.summary || `${project.title} — ${name}`}
      canonical={`${canonicalBase}/work/${slug}`}
      ogTitle={`${project.title} — ${name}`}
      ogDescription={project.summary}
      authorName={name}
      defaultTheme={defaultTheme}
      accent={accent}
      glowIntensity={glowIntensity}
      jsonLd={schemaGraph}
      settings={settings}
    >
      <!-- Detail Header Navigation -->
      <header class="detail-header">
        <div class="detail-header-inner">
          <a href="/" class="brand-logo" aria-label={brandHomeAria}>
            <span class="logo-text">{brandMark}</span><span class="logo-dot">.</span>
          </a>
          <nav class="detail-nav-links" aria-label={breadcrumbAria}>
            <a href="/work" class="back-link">
              <span aria-hidden="true">←</span>
              <span>{allWorkLabel}</span>
            </a>
            <Button variant="primary" size="sm" href="/#contact">
              {discussBtnLabel}
            </Button>
          </nav>
        </div>
      </header>

      <main id="main-content" class="project-detail-main">
        <div class="project-detail-container">
          <!-- Breadcrumb Trail -->
          <nav class="breadcrumb-trail" aria-label={breadcrumbAria}>
            <a href="/">{homeLabel}</a>
            <span class="crumb-sep">/</span>
            <a href="/work">{workLabel}</a>
            <span class="crumb-sep">/</span>
            <span class="crumb-current">{project.title}</span>
          </nav>

          <!-- Case Study Hero Header -->
          <div class="case-study-hero">
            <div class="hero-cat-wrap">
              <div class="hero-cat">
                <Icon name={project.category_icon || 'folder'} size={16} />
                <span>{project.category}</span>
              </div>
              {project.featured && <Pill variant="accent" size="sm">{featuredPill}</Pill>}
            </div>

            <h1 class="case-study-title">{project.title}</h1>
            <p class="case-study-summary" set:html={sanitizeBasicHtml(project.summary)} />

            <!-- Links & Repository Actions -->
            <div class="case-study-actions">
              {project.demo_url && (
                <Button variant="primary" size="md" href={project.demo_url} target="_blank">
                  <span>{liveDemoBtn}</span>
                  <span aria-hidden="true">↗</span>
                </Button>
              )}
              {project.external_url && !project.demo_url && (
                <Button variant="primary" size="md" href={project.external_url} target="_blank">
                  <span>{exploreBtn}</span>
                  <span aria-hidden="true">↗</span>
                </Button>
              )}
              {project.github_url && (
                <Button variant="secondary" size="md" href={project.github_url} target="_blank">
                  <Icon name="code" size={16} />
                  <span>{githubBtn}</span>
                  <span aria-hidden="true">↗</span>
                </Button>
              )}
            </div>

            <!-- Tech Stack Tags -->
            {allTags.length > 0 && (
              <div class="tech-pills-row">
                <span class="tech-label">{stackLabel}</span>
                <div class="tech-pills-list">
                  {allTags.map((tag) => (
                    <span class="tech-pill">{tag}</span>
                  ))}
                </div>
              </div>
            )}
          </div>

          <!-- Structured Case Study Sections -->
          <div class="case-study-content">
            <!-- 1. The Challenge -->
            <section class="cs-section">
              <div class="cs-badge">{probBadge}</div>
              <h2 class="cs-heading">{probHeading}</h2>
              <div class="cs-body">
                {project.problem ? (
                  <p set:html={sanitizeBasicHtml(project.problem)} />
                ) : (
                  <p set:html={sanitizeBasicHtml(probFallback)} />
                )}
              </div>
            </section>

            <!-- 2. The Solution -->
            <section class="cs-section">
              <div class="cs-badge">{solBadge}</div>
              <h2 class="cs-heading">{solHeading}</h2>
              <div class="cs-body">
                {project.solution ? (
                  <p set:html={sanitizeBasicHtml(project.solution)} />
                ) : (
                  <p set:html={sanitizeBasicHtml(solFallback)} />
                )}
              </div>
            </section>

            <!-- 3. Key Results -->
            <section class="cs-section">
              <div class="cs-badge">{resBadge}</div>
              <h2 class="cs-heading">{resHeading}</h2>
              <div class="cs-body">
                {project.result ? (
                  <p set:html={sanitizeBasicHtml(project.result)} />
                ) : (
                  <p set:html={sanitizeBasicHtml(resFallback)} />
                )}
              </div>
            </section>

            <!-- Bottom CTA Card -->
            <Card class="cs-contact-card">
              <h3 class="cs-contact-title">{ctaTitle}</h3>
              <p class="cs-contact-desc">{ctaDesc}</p>
              <Button variant="primary" size="lg" href="/#contact">
                <span>{ctaBtn}</span>
                <span aria-hidden="true">→</span>
              </Button>
            </Card>
          </div>

          <!-- Related Work -->
          {relatedProjects.length > 0 && (
            <div class="related-work-block">
              <h3 class="related-work-title">{relatedTitle}</h3>
              <div class="related-work-grid">
                {relatedProjects.map((rp) => (
                  <Card as="a" href={`/work/${rp.slug}`} class="related-proj-card" interactive={true}>
                    <div class="rp-cat">
                      <Icon name={rp.category_icon || 'folder'} size={14} />
                      <span>{rp.category}</span>
                    </div>
                    <h4 class="rp-title">{rp.title}</h4>
                    <p class="rp-summary" set:html={sanitizeBasicHtml(rp.summary)} />
                    <span class="rp-link">{readCaseStudy}</span>
                  </Card>
                ))}
              </div>
            </div>
          )}
        </div>
      </main>

      <footer class="detail-footer">
        <div class="detail-footer-inner">
          <span>{name} · {location}</span>
          <a href="/work">{backWorkLabel}</a>
        </div>
      </footer>
    </BaseLayout>
  )
}

<style>
  .detail-header {
    position: sticky;
    top: 0;
    z-index: 100;
    height: var(--nav-height);
    background: rgba(10, 12, 11, 0.88);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--border);
  }

  :global([data-theme="light"]) .detail-header {
    background: rgba(246, 247, 244, 0.94);
  }

  .detail-header-inner {
    max-width: var(--max-w-content);
    height: 100%;
    margin: 0 auto;
    padding: 0 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .brand-logo {
    font-family: var(--ff-sans);
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--heading);
    text-decoration: none;
  }

  .logo-dot {
    color: var(--accent);
  }

  .detail-nav-links {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--ff-sans);
    font-size: var(--fs-xs);
    font-weight: 500;
    color: var(--muted);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .back-link:hover {
    color: var(--heading);
  }

  .project-detail-main {
    padding: 36px 20px 64px;
    background: var(--bg);
  }

  .project-detail-container {
    max-width: 920px;
    margin: 0 auto;
  }

  .breadcrumb-trail {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    font-family: var(--ff-mono);
    font-size: var(--fs-xs);
    color: var(--muted);
    margin-bottom: var(--sp-5);
  }

  .breadcrumb-trail a {
    color: var(--muted);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .breadcrumb-trail a:hover {
    color: var(--accent);
  }

  .crumb-sep {
    opacity: 0.5;
  }

  .crumb-current {
    color: var(--heading);
    font-weight: 600;
  }

  .case-study-hero {
    padding-bottom: var(--sp-6);
    border-bottom: 1px solid var(--border);
    margin-bottom: var(--sp-6);
  }

  .hero-cat-wrap {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--sp-3);
    margin-bottom: var(--sp-3);
  }

  .hero-cat {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--ff-mono);
    font-size: var(--fs-xs);
    font-weight: 500;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .case-study-title {
    font-family: var(--ff-sans);
    font-size: var(--fs-3xl);
    font-weight: 800;
    color: var(--heading);
    letter-spacing: -0.03em;
    line-height: 1.12;
    margin-bottom: var(--sp-4);
  }

  .case-study-summary {
    font-family: var(--ff-sans);
    font-size: var(--fs-md);
    color: var(--muted);
    line-height: 1.65;
    margin-bottom: var(--sp-5);
  }

  .case-study-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: var(--sp-5);
  }

  .tech-pills-row {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-top: var(--sp-4);
    border-top: 1px solid var(--border-subtle);
  }

  .tech-label {
    font-family: var(--ff-mono);
    font-size: 0.72rem;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .tech-pills-list {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .tech-pill {
    font-family: var(--ff-mono);
    font-size: 0.72rem;
    padding: 3px 8px;
    border-radius: var(--radius-sm);
    background: var(--surface);
    color: var(--text-muted);
    border: 1px solid var(--border);
  }

  /* Case study content sections */
  .case-study-content {
    display: flex;
    flex-direction: column;
    gap: var(--sp-6);
    margin-bottom: var(--sp-7);
  }

  .cs-section {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
  }

  .cs-badge {
    font-family: var(--ff-mono);
    font-size: var(--fs-xs);
    font-weight: 500;
    color: var(--accent);
    letter-spacing: 0.08em;
  }

  .cs-heading {
    font-family: var(--ff-sans);
    font-size: var(--fs-xl);
    font-weight: 700;
    color: var(--heading);
    letter-spacing: -0.015em;
    margin-bottom: var(--sp-2);
  }

  .cs-body p {
    font-family: var(--ff-sans);
    font-size: var(--fs-base);
    color: var(--text);
    line-height: 1.72;
  }

  /* Contact CTA card */
  :global(.cs-contact-card) {
    margin-top: var(--sp-3);
    padding: 24px 20px !important;
    background: var(--surface) !important;
    text-align: center;
    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
  }

  .cs-contact-title {
    font-family: var(--ff-sans);
    font-size: var(--fs-lg);
    font-weight: 700;
    color: var(--heading);
    margin-bottom: var(--sp-2);
  }

  .cs-contact-desc {
    font-family: var(--ff-sans);
    font-size: var(--fs-sm);
    color: var(--muted);
    max-width: 52ch;
    margin-bottom: var(--sp-5);
    line-height: 1.6;
  }

  /* Related work block */
  .related-work-block {
    margin-top: var(--sp-7);
    padding-top: var(--sp-6);
    border-top: 1px solid var(--border);
  }

  .related-work-title {
    font-family: var(--ff-sans);
    font-size: var(--fs-lg);
    font-weight: 700;
    color: var(--heading);
    margin-bottom: var(--sp-4);
  }

  .related-work-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }

  :global(.related-proj-card) {
    padding: 20px !important;
    text-decoration: none;
    display: flex !important;
    flex-direction: column !important;
    height: 100% !important;
  }

  .rp-cat {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--ff-mono);
    font-size: 0.72rem;
    color: var(--accent);
    margin-bottom: var(--sp-2);
  }

  .rp-title {
    font-family: var(--ff-sans);
    font-size: var(--fs-base);
    font-weight: 700;
    color: var(--heading);
    margin-bottom: var(--sp-2);
    line-height: 1.3;
  }

  .rp-summary {
    font-family: var(--ff-sans);
    font-size: var(--fs-xs);
    color: var(--muted);
    line-height: 1.55;
    margin-bottom: var(--sp-4);
    flex-grow: 1;
  }

  .rp-link {
    font-family: var(--ff-sans);
    font-size: var(--fs-xs);
    font-weight: 600;
    color: var(--accent);
    margin-top: auto;
    transition: color var(--transition-fast);
  }

  .detail-footer {
    border-top: 1px solid var(--border);
    padding: 28px 20px;
    background: var(--surface);
  }

  .detail-footer-inner {
    max-width: var(--max-w-content);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-family: var(--ff-mono);
    font-size: var(--fs-xs);
    color: var(--muted);
  }

  .detail-footer-inner a {
    color: var(--accent);
    text-decoration: none;
  }

  .not-found-wrap {
    min-height: 80vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: var(--sp-6) 20px;
  }

  .nf-eyebrow {
    font-family: var(--ff-mono);
    color: var(--accent);
    font-size: var(--fs-xs);
    margin-bottom: var(--sp-2);
  }

  .nf-title {
    font-family: var(--ff-sans);
    font-size: var(--fs-3xl);
    font-weight: 800;
    color: var(--heading);
    margin-bottom: var(--sp-3);
  }

  .nf-desc {
    font-family: var(--ff-sans);
    font-size: var(--fs-base);
    color: var(--muted);
    margin-bottom: var(--sp-6);
  }

  .nf-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--sp-3);
  }

  @media (min-width: 640px) {
    .detail-header-inner {
      padding: 0 28px;
    }
    .project-detail-main {
      padding: 48px 28px 72px;
    }
    :global(.cs-contact-card) {
      padding: 32px !important;
    }
    .related-work-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 20px;
    }
    .detail-footer {
      padding: 32px 28px;
    }
    .detail-footer-inner {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  @media (min-width: 1024px) {
    .detail-header-inner {
      padding: 0 32px;
    }
    .project-detail-main {
      padding: 64px 32px 84px;
    }
    .related-work-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
