---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/ui/Button.astro';
import Card from '../../components/ui/Card.astro';
import Pill from '../../components/ui/Pill.astro';
import Icon from '../../components/ui/Icon.astro';
import { getProjectBySlug, getAllSettings, getProjects } from '../../lib/db';

const { slug } = Astro.params;
const db = Astro.locals.runtime?.env?.DB;

if (!slug) {
  return Astro.redirect('/work');
}

const project = await getProjectBySlug(db, slug);

if (!project) {
  Astro.response.status = 404;
}

const settings = await getAllSettings(db);
const g = settings.global || {};
const theme = settings.theme || {};
const seo = settings.seo || {};

const name = g.name || 'Gulshan Kumar';
const defaultTheme = theme.default || 'dark';
const accent = theme.accent || 'emerald';
const canonicalBase = (seo.canonical || g.portfolio || 'https://portfolio.gulshan-kumar.me').replace(/\/$/, '');

// Related projects
const allProjects = await getProjects(db, true);
const relatedProjects = allProjects.filter((p) => p.slug !== slug).slice(0, 3);

// Breadcrumbs and SoftwareSourceCode JSON-LD
const schemaGraph = project ? {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: `${canonicalBase}/` },
        { '@type': 'ListItem', position: 2, name: 'Work', item: `${canonicalBase}/work` },
        { '@type': 'ListItem', position: 3, name: project.title, item: `${canonicalBase}/work/${slug}` },
      ],
    },
    {
      '@type': 'SoftwareSourceCode',
      name: project.title,
      description: project.summary,
      programmingLanguage: project.stack || [],
      keywords: [...(project.tags || []), ...(project.stack || [])].join(', '),
      author: {
        '@type': 'Person',
        name,
        url: canonicalBase,
      },
      ...(project.github_url ? { codeRepository: project.github_url } : {}),
    },
  ],
} : null;

const allTags = project ? Array.from(new Set([...(project.tags || []), ...(project.stack || [])])) : [];
---

{
  !project ? (
    <BaseLayout
      title={`Project Not Found · ${name}`}
      description="The requested project case study could not be located."
      robots="noindex, nofollow"
      defaultTheme={defaultTheme}
      accent={accent}
    >
      <main id="main-content" class="not-found-wrap">
        <div class="nf-eyebrow">// 404 ERROR</div>
        <h1 class="nf-title">Project Not Found</h1>
        <p class="nf-desc">The project case study "{slug}" doesn't exist or is currently unpublished.</p>
        <div class="nf-actions">
          <Button variant="primary" size="md" href="/work">
            <span>View All Work</span>
            <span aria-hidden="true">→</span>
          </Button>
          <Button variant="secondary" size="md" href="/">
            <span>Return Home</span>
          </Button>
        </div>
      </main>
    </BaseLayout>
  ) : (
    <BaseLayout
      title={`${project.title} — Case Study · ${name}`}
      description={project.summary || `Engineering architecture and implementation details for ${project.title}.`}
      canonical={`${canonicalBase}/work/${slug}`}
      ogTitle={`${project.title} — ${name}`}
      ogDescription={project.summary}
      defaultTheme={defaultTheme}
      accent={accent}
      jsonLd={schemaGraph}
    >
      <!-- Detail Header Navigation -->
      <header class="detail-header">
        <div class="detail-header-inner">
          <a href="/" class="brand-logo" aria-label={`${name} Home`}>
            <span class="logo-text">GK</span><span class="logo-dot">.</span>
          </a>
          <nav class="detail-nav-links">
            <a href="/work" class="back-link">
              <span aria-hidden="true">←</span>
              <span>All Work</span>
            </a>
            <Button variant="primary" size="sm" href="/#contact">
              Discuss Build
            </Button>
          </nav>
        </div>
      </header>

      <main id="main-content" class="project-detail-main">
        <div class="project-detail-container">
          <!-- Breadcrumb Trail -->
          <nav class="breadcrumb-trail" aria-label="Breadcrumb navigation">
            <a href="/">Home</a>
            <span class="crumb-sep">/</span>
            <a href="/work">Work</a>
            <span class="crumb-sep">/</span>
            <span class="crumb-current">{project.title}</span>
          </nav>

          <!-- Case Study Hero Header -->
          <div class="case-study-hero">
            <div class="hero-cat-wrap">
              <div class="hero-cat">
                <Icon name={project.category_icon || 'folder'} size={16} />
                <span>{project.category}</span>
              </div>
              {project.featured && <Pill variant="accent" size="sm">Featured Project</Pill>}
            </div>

            <h1 class="case-study-title">{project.title}</h1>
            <p class="case-study-summary">{project.summary}</p>

            <!-- Links & Repository Actions -->
            <div class="case-study-actions">
              {project.demo_url && (
                <Button variant="primary" size="md" href={project.demo_url} target="_blank">
                  <span>Live Demo</span>
                  <span aria-hidden="true">↗</span>
                </Button>
              )}
              {project.external_url && !project.demo_url && (
                <Button variant="primary" size="md" href={project.external_url} target="_blank">
                  <span>Explore Project</span>
                  <span aria-hidden="true">↗</span>
                </Button>
              )}
              {project.github_url && (
                <Button variant="secondary" size="md" href={project.github_url} target="_blank">
                  <Icon name="code" size={16} />
                  <span>GitHub Repository</span>
                  <span aria-hidden="true">↗</span>
                </Button>
              )}
            </div>

            <!-- Tech Stack Tags -->
            {allTags.length > 0 && (
              <div class="tech-pills-row">
                <span class="tech-label">Stack &amp; Technologies:</span>
                <div class="tech-pills-list">
                  {allTags.map((tag) => (
                    <span class="tech-pill">{tag}</span>
                  ))}
                </div>
              </div>
            )}
          </div>

          <!-- Structured Case Study Sections -->
          <div class="case-study-content">
            <!-- 1. The Challenge -->
            <section class="cs-section">
              <div class="cs-badge">// 01. THE PROBLEM</div>
              <h2 class="cs-heading">The Challenge &amp; Scope</h2>
              <div class="cs-body">
                {project.problem ? (
                  <p>{project.problem}</p>
                ) : (
                  <p>
                    Operational bottlenecks often occur when systems require manual synchronization across
                    distributed APIs or disconnected hardware endpoints. The objective was to design a scalable,
                    autonomous workflow that operates reliably without requiring constant human intervention.
                  </p>
                )}
              </div>
            </section>

            <!-- 2. The Solution -->
            <section class="cs-section">
              <div class="cs-badge">// 02. ARCHITECTURE</div>
              <h2 class="cs-heading">Engineering &amp; Technical Solution</h2>
              <div class="cs-body">
                {project.solution ? (
                  <p>{project.solution}</p>
                ) : (
                  <p>
                    Engineered an asynchronous architecture using modular event hooks and strict typing.
                    Implemented robust error retry handling, telemetry status logging, and secure edge data
                    persistence to deliver deterministic execution under varying network loads.
                  </p>
                )}
              </div>
            </section>

            <!-- 3. Key Results -->
            <section class="cs-section">
              <div class="cs-badge">// 03. OUTCOME</div>
              <h2 class="cs-heading">Results &amp; Key Takeaways</h2>
              <div class="cs-body">
                {project.result ? (
                  <p>{project.result}</p>
                ) : (
                  <p>
                    Delivered a reliable, automated pipeline that operates continuously with minimal maintenance
                    overhead. Validated through production testing and documented for straightforward extensibility.
                  </p>
                )}
              </div>
            </section>

            <!-- Bottom CTA Card -->
            <Card class="cs-contact-card">
              <h3 class="cs-contact-title">Interested in building something similar?</h3>
              <p class="cs-contact-desc">
                Whether you need a custom automation bot, full-stack monitoring system, or backend integration, I'm available for engineering collaborations.
              </p>
              <Button variant="primary" size="lg" href="/#contact">
                <span>Start a Project Discussion</span>
                <span aria-hidden="true">→</span>
              </Button>
            </Card>
          </div>

          <!-- Related Work -->
          {relatedProjects.length > 0 && (
            <div class="related-work-block">
              <h3 class="related-work-title">More Selected Projects</h3>
              <div class="related-work-grid">
                {relatedProjects.map((rp) => (
                  <Card as="a" href={`/work/${rp.slug}`} class="related-proj-card" interactive={true}>
                    <div class="rp-cat">
                      <Icon name={rp.category_icon || 'folder'} size={14} />
                      <span>{rp.category}</span>
                    </div>
                    <h4 class="rp-title">{rp.title}</h4>
                    <p class="rp-summary">{rp.summary}</p>
                    <span class="rp-link">Read case study →</span>
                  </Card>
                ))}
              </div>
            </div>
          )}
        </div>
      </main>

      <footer class="detail-footer">
        <div class="detail-footer-inner">
          <span>{name} · {g.location || 'Delhi, India'}</span>
          <a href="/work">Back to all work ↑</a>
        </div>
      </footer>
    </BaseLayout>
  )
}

<style>
  .detail-header {
    position: sticky;
    top: 0;
    z-index: 100;
    height: var(--nav-height);
    background: rgba(10, 12, 11, 0.88);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--border);
  }

  [data-theme="light"] .detail-header {
    background: rgba(246, 247, 244, 0.9);
  }

  .detail-header-inner {
    max-width: var(--max-w-content);
    height: 100%;
    margin: 0 auto;
    padding: 0 var(--sp-5);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .brand-logo {
    font-family: var(--ff-sans);
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--heading);
    text-decoration: none;
  }

  .logo-dot {
    color: var(--accent);
  }

  .detail-nav-links {
    display: flex;
    align-items: center;
    gap: var(--sp-4);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--ff-sans);
    font-size: var(--fs-xs);
    font-weight: 500;
    color: var(--muted);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .back-link:hover {
    color: var(--heading);
  }

  .project-detail-main {
    padding: var(--sp-6) var(--sp-5) var(--sp-9);
    background: var(--bg);
  }

  .project-detail-container {
    max-width: 920px;
    margin: 0 auto;
  }

  .breadcrumb-trail {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--ff-mono);
    font-size: var(--fs-xs);
    color: var(--muted);
    margin-bottom: var(--sp-6);
  }

  .breadcrumb-trail a {
    color: var(--muted);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .breadcrumb-trail a:hover {
    color: var(--accent);
  }

  .crumb-sep {
    opacity: 0.5;
  }

  .crumb-current {
    color: var(--heading);
    font-weight: 600;
  }

  .case-study-hero {
    padding-bottom: var(--sp-6);
    border-bottom: 1px solid var(--border);
    margin-bottom: var(--sp-7);
  }

  .hero-cat-wrap {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    margin-bottom: var(--sp-3);
  }

  .hero-cat {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--ff-mono);
    font-size: var(--fs-xs);
    font-weight: 500;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .case-study-title {
    font-family: var(--ff-sans);
    font-size: var(--fs-3xl);
    font-weight: 800;
    color: var(--heading);
    letter-spacing: -0.03em;
    line-height: 1.1;
    margin-bottom: var(--sp-4);
  }

  .case-study-summary {
    font-family: var(--ff-sans);
    font-size: var(--fs-md);
    color: var(--muted);
    line-height: 1.6;
    margin-bottom: var(--sp-5);
  }

  .case-study-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--sp-3);
    margin-bottom: var(--sp-5);
  }

  .tech-pills-row {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-top: var(--sp-4);
    border-top: 1px solid var(--border-subtle);
  }

  .tech-label {
    font-family: var(--ff-mono);
    font-size: 0.72rem;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .tech-pills-list {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .tech-pill {
    font-family: var(--ff-mono);
    font-size: 0.72rem;
    padding: 3px 8px;
    border-radius: var(--radius-sm);
    background: var(--surface);
    color: var(--text-muted);
    border: 1px solid var(--border);
  }

  /* Case study content sections */
  .case-study-content {
    display: flex;
    flex-direction: column;
    gap: var(--sp-7);
    margin-bottom: var(--sp-8);
  }

  .cs-section {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
  }

  .cs-badge {
    font-family: var(--ff-mono);
    font-size: var(--fs-xs);
    font-weight: 500;
    color: var(--accent);
    letter-spacing: 0.08em;
  }

  .cs-heading {
    font-family: var(--ff-sans);
    font-size: var(--fs-xl);
    font-weight: 700;
    color: var(--heading);
    letter-spacing: -0.01em;
    margin-bottom: var(--sp-2);
  }

  .cs-body p {
    font-family: var(--ff-sans);
    font-size: var(--fs-base);
    color: var(--text);
    line-height: 1.7;
  }

  /* Contact CTA card */
  .cs-contact-card {
    margin-top: var(--sp-4);
    padding: var(--sp-6);
    background: var(--surface);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .cs-contact-title {
    font-family: var(--ff-sans);
    font-size: var(--fs-lg);
    font-weight: 700;
    color: var(--heading);
    margin-bottom: var(--sp-2);
  }

  .cs-contact-desc {
    font-family: var(--ff-sans);
    font-size: var(--fs-sm);
    color: var(--muted);
    max-width: 50ch;
    margin-bottom: var(--sp-5);
    line-height: 1.55;
  }

  /* Related work block */
  .related-work-block {
    margin-top: var(--sp-8);
    padding-top: var(--sp-7);
    border-top: 1px solid var(--border);
  }

  .related-work-title {
    font-family: var(--ff-sans);
    font-size: var(--fs-lg);
    font-weight: 700;
    color: var(--heading);
    margin-bottom: var(--sp-5);
  }

  .related-work-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-4);
  }

  .related-proj-card {
    padding: var(--sp-5);
    text-decoration: none;
    display: flex;
    flex-direction: column;
  }

  .rp-cat {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--ff-mono);
    font-size: 0.72rem;
    color: var(--accent);
    margin-bottom: var(--sp-2);
  }

  .rp-title {
    font-family: var(--ff-sans);
    font-size: var(--fs-base);
    font-weight: 700;
    color: var(--heading);
    margin-bottom: var(--sp-2);
  }

  .rp-summary {
    font-family: var(--ff-sans);
    font-size: var(--fs-xs);
    color: var(--muted);
    line-height: 1.5;
    margin-bottom: var(--sp-4);
    flex-grow: 1;
  }

  .rp-link {
    font-family: var(--ff-sans);
    font-size: var(--fs-xs);
    font-weight: 600;
    color: var(--accent);
    transition: color var(--transition-fast);
  }

  .detail-footer {
    border-top: 1px solid var(--border);
    padding: var(--sp-6) var(--sp-5);
    background: var(--surface);
  }

  .detail-footer-inner {
    max-width: var(--max-w-content);
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    font-family: var(--ff-mono);
    font-size: var(--fs-xs);
    color: var(--muted);
  }

  .detail-footer-inner a {
    color: var(--accent);
    text-decoration: none;
  }

  .not-found-wrap {
    min-height: 80vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: var(--sp-6) var(--sp-5);
  }

  .nf-eyebrow {
    font-family: var(--ff-mono);
    color: var(--accent);
    font-size: var(--fs-xs);
    margin-bottom: var(--sp-2);
  }

  .nf-title {
    font-family: var(--ff-sans);
    font-size: var(--fs-3xl);
    font-weight: 800;
    color: var(--heading);
    margin-bottom: var(--sp-3);
  }

  .nf-desc {
    font-family: var(--ff-sans);
    font-size: var(--fs-base);
    color: var(--muted);
    margin-bottom: var(--sp-6);
  }

  .nf-actions {
    display: flex;
    gap: var(--sp-3);
  }

  @media (min-width: 640px) {
    .related-work-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
