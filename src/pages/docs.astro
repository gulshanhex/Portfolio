---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import '../styles/docs.css';
import { getAllSettings } from '../lib/db';

const db = Astro.locals.runtime?.env?.DB;
const settings = await getAllSettings(db);
const g = settings.global || {};
const theme = settings.theme || {};
const defaultTheme = theme.default || 'dark';
const accent = theme.accent || 'emerald';
const glowIntensity = theme.glow_intensity || theme.neon_intensity || 'subtle';
const canonicalBase = (settings.seo?.canonical || g.portfolio || 'https://portfolio.example.com').replace(/\/$/, '');
---

<BaseLayout
  title="Documentation & Deployment Guide · Portfolio CMS"
  description="Complete guide to deploying on Cloudflare Workers + D1, configuring secrets, and managing every text string from /admin."
  canonical={`${canonicalBase}/docs`}
  robots="noindex, nofollow"
  defaultTheme={defaultTheme}
  accent={accent}
  glowIntensity={glowIntensity}
  settings={settings}
>
  <header class="docs-header">
    <div class="docs-header-inner">
      <a href="/" class="brand-logo" aria-label="Portfolio Home">
        <span>GK</span><span class="logo-dot">.</span>
      </a>
      <div class="docs-header-actions">
        <a href="/" class="back-nav-link">← Portfolio</a>
        <Button variant="primary" size="sm" href="/admin">
          Admin →
        </Button>
      </div>
    </div>
  </header>

  <main id="main-content" class="docs-wrap">
    <a href="/" class="back-link">
      <span class="material-icons-round" aria-hidden="true">arrow_back</span>
      <span>Back to Portfolio</span>
    </a>

    <div class="docs-eyebrow">// DOCUMENTATION</div>
    <h1 class="docs-title">
      Cloudflare Deploy &amp; <span style="color:var(--accent)">Architecture Docs</span>
    </h1>
    <p class="docs-sub">
      Modular Astro 5 SSR architecture on Cloudflare Workers + D1 edge database — configured for public GitHub
      repositories with zero secrets stored in <code>wrangler.toml</code> or <code>wrangler.jsonc</code>.
    </p>

    <nav class="docs-nav" aria-label="Documentation sections">
      <a href="#existing-worker">Cloudflare + GitHub</a>
      <a href="#secrets-setup">Secrets Setup</a>
      <a href="#architecture">Architecture</a>
      <a href="#d1-setup">D1 Database</a>
      <a href="#seo-geo-aeo">SEO / GEO / AEO</a>
      <a href="#content">Managing Content</a>
      <a href="#security">Security Notes</a>
    </nav>

    <section class="doc-sec" id="existing-worker">
      <div class="section-num">// 01</div>
      <h2>Connect Public GitHub Repository to Cloudflare Workers</h2>
      <p>
        You can connect a public GitHub repository directly to an existing Cloudflare Worker without deleting the Worker,
        preserving your custom domain, D1 database binding (<code>DB</code>), and encrypted secrets:
      </p>
      <div class="step">
        <div class="step-num">Step 1</div>
        <div class="step-title">Push Code to Your Public GitHub Repository</div>
        <div class="step-body">
          Push the project files to the root of your GitHub repository. Both <code>wrangler.toml</code> and{' '}
          <code>wrangler.jsonc</code> set <code>keep_vars = true</code> and contain zero hardcoded secrets.
        </div>
      </div>
      <div class="step">
        <div class="step-num">Step 2</div>
        <div class="step-title">Confirm Worker Name Matches</div>
        <div class="step-body">
          Verify that <code>name</code> in <code>wrangler.jsonc</code> and <code>wrangler.toml</code> matches your
          Cloudflare Worker name.
        </div>
      </div>
      <div class="step">
        <div class="step-num">Step 3</div>
        <div class="step-title">Link GitHub in Worker → Settings → Build</div>
        <div class="step-body">
          Open Cloudflare Dashboard → <strong>Workers &amp; Pages</strong> → select your Worker →{' '}
          <strong>Settings</strong> → <strong>Build</strong> → <strong>Connect to Git</strong> and select your repository.
        </div>
      </div>
      <div class="step">
        <div class="step-num">Step 4</div>
        <div class="step-title">Configure Build Settings</div>
        <div class="step-body">
          Production branch: <code>main</code><br />
          Build command: <code>npm run build</code><br />
          Deploy command: <code>npx wrangler deploy --keep-vars</code><br />
          Root directory: <code>/</code>
        </div>
      </div>
      <div class="note">
        <strong>Why --keep-vars / keep_vars = true matters:</strong> When Cloudflare deploys from GitHub,{' '}
        <code>keep_vars = true</code> ensures that secrets saved under <strong>Variables and Secrets</strong> in the
        Cloudflare Dashboard are never overwritten or deleted.
      </div>
    </section>

    <section class="doc-sec" id="secrets-setup">
      <div class="section-num">// 02</div>
      <h2>Worker Variables &amp; Secrets</h2>
      <p>
        Store all sensitive tokens in the Cloudflare Dashboard under <strong>Settings → Variables and Secrets</strong>{' '}
        using <strong>Secret</strong> mode:
      </p>
      <div class="codeblock">
        <code>{`1. Variable name: ADMIN_SETUP_TOKEN   | Type: Secret | Value: <32+ char random setup token>
2. Variable name: SESSION_SECRET      | Type: Secret | Value: <32+ char random session secret>
3. Variable name: ADMIN_ACCESS_KEY    | Type: Secret | Value: <optional secondary login key>
4. Variable name: SITE_URL            | Type: Secret | Value: https://portfolio.example.com (optional)`}</code>
      </div>
    </section>

    <section class="doc-sec" id="architecture">
      <div class="section-num">// 03</div>
      <h2>Modular Astro Architecture</h2>
      <p>
        This portfolio runs on <strong style="color:var(--text)">Astro 5 SSR + @astrojs/cloudflare + Cloudflare D1</strong>.
        Every UI section, layout, stylesheet, database helper, and API endpoint is cleanly separated into modular files,
        and every public string is registered in <code>src/lib/ui-strings.ts</code> and editable in <code>/admin</code>.
      </p>
    </section>

    <section class="doc-sec" id="d1-setup">
      <div class="section-num">// 04</div>
      <h2>D1 Database &amp; First-Run Setup</h2>
      <p>
        Visit <code>/setup?token=YOUR_ADMIN_SETUP_TOKEN</code> once after deployment to initialize all D1 tables and
        create your administrator account.
      </p>
    </section>

    <section class="doc-sec" id="seo-geo-aeo">
      <div class="section-num">// 05</div>
      <h2>SEO, GEO &amp; AEO Endpoints</h2>
      <p>
        Dynamic endpoints include <code>/sitemap.xml</code>, <code>/robots.txt</code>, <code>/llms.txt</code>,{' '}
        <code>/llms-full.txt</code>, and <code>/og-image.svg</code>, all powered live from Cloudflare D1.
      </p>
    </section>

    <section class="doc-sec" id="content">
      <div class="section-num">// 06</div>
      <h2>Managing Content &amp; Interface Text</h2>
      <p>
        Sign in at <code>/admin</code> to edit Global settings, Hero &amp; About, Section Copy, Interface Text,
        Services, Projects, Skills, Experience, Education, Proof &amp; Testimonials, FAQs, Contact, Sections &amp; Order,
        SEO, Theme, Security/2FA, and JSON Backup &amp; Restore.
      </p>
    </section>

    <section class="doc-sec" id="security">
      <div class="section-num">// 07</div>
      <h2>Security Controls</h2>
      <p>
        Includes PBKDF2-SHA256 password hashing (100,000 iterations), HMAC-SHA256 signed sessions, per-session CSRF
        tokens, RFC 6238 TOTP 2FA, login rate limiting, and honeypot + elapsed-time bot protection on the contact form.
      </p>
    </section>
  </main>
</BaseLayout>
