                    <span class="badge ${p.visible ? 'ok' : 'off'}">${p.visible ? 'On' : 'Off'}</span>
                    <button class="lbtn" type="button" onclick="openProofItem('${esc(p.type)}',${p.id})"><span class="material-icons-round mi">edit</span>Edit</button>
                    <button class="lbtn del" type="button" onclick="delItem('proof',${p.id},loadProof)"><span class="material-icons-round mi">delete</span></button>
                  </div>
                </div>`
                    )
                    .join('')
                : '<div style="color:var(--text-faint);font-size:.8rem">No items yet.</div>';
            } catch (e) {
              toast(e.message, true);
            }
          }
          async function saveProofCfg() {
            try {
              const s = ST.settings || (await api('/settings')).settings || {};
              const payload = {
                proof_section: {
                  ...(s.proof_section || {}),
                  section_title: val('proof-title') || 'Testimonials',
                  orgs_title: val('proof-orgs-title') || "Who I've worked with",
                  orgs_subtitle: val('proof-orgs-sub'),
                  testimonials_title: val('proof-rv-title') || 'What People Say',
                  show_orgs: chk('proof-show-orgs'),
                  show_testimonials: chk('proof-show-rv'),
                },
              };
              const res = await api('/settings', 'POST', payload);
              if (res.ok && Array.isArray(res.saved) && res.saved.includes('proof_section')) {
                ST.settings = { ...s, ...payload };
                toast('Proof config saved!');
              } else {
                toast(res.error || 'Server did not confirm save', true);
              }
            } catch (e) {
              toast(e.message, true);
            }
          }
          async function openProofItem(type, id) {
            const p = ST.proof?.find((x) => x.id === id) || null;
            const isTrv = type === 'testimonial';
            $('mbody').innerHTML = `
              <div class="modal-title">${p ? 'EDIT' : 'ADD'} ${isTrv ? 'TESTIMONIAL' : 'ORGANIZATION'}</div>
              <div class="fgrid" style="margin-bottom:1rem">
                <div class="fg"><label>Name</label><input id="m-name" value="${esc(p?.name || '')}"/></div>
                <div class="fg"><label>Subtitle / Role · Company</label><input id="m-sub" value="${esc(p?.subtitle || '')}"/></div>
                <div class="fg full"><label>Logo / Avatar URL (optional — leave blank for clean initials badge)</label><input id="m-logo" value="${esc(p?.logo_url || '')}"/></div>
                ${!isTrv ? `<div class="fg full"><label>Website URL</label><input id="m-url" value="${esc(p?.url || '')}"/></div>` : ''}
                ${
                  isTrv
                    ? `<div class="fg full"><label>Testimonial Text (supports &lt;strong&gt; &lt;em&gt;)</label><textarea id="m-text" style="min-height:90px">${esc(p?.testimonial_text || '')}</textarea></div>
                  <div class="fg"><label>Rating (1–5)</label><input id="m-rating" type="number" min="1" max="5" value="${p?.testimonial_rating || 5}"/></div>`
                    : ''
                }
                <div class="fg"><label>Order</label><input id="m-ord" type="number" value="${p?.order_idx || 0}"/></div>
                <div class="fg" style="padding-top:1rem"><div class="trow"><div class="tlbl">Visible</div><label class="tsw"><input type="checkbox" id="m-vis" ${p?.visible !== false ? 'checked' : ''}/><span class="tsl"></span></label></div></div>
              </div>
              <div class="brow"><button class="btn-s" type="button" onclick="saveProofItem('${type}',${id || 'null'})"><span class="material-icons-round mi">save</span>Save</button><button class="btn-o" type="button" onclick="closeModal()">Cancel</button></div>`;
            openModal();
          }
          async function saveProofItem(type, id) {
            try {
              const isTrv = type === 'testimonial';
              const body = {
                type,
                name: val('m-name'),
                subtitle: val('m-sub'),
                logo_url: val('m-logo') || null,
                order_idx: parseInt(val('m-ord')) || 0,
                visible: chk('m-vis'),
                url: !isTrv ? val('m-url') || null : null,
                testimonial_text: isTrv ? val('m-text') : null,
                testimonial_rating: isTrv ? parseInt(val('m-rating')) || 5 : null,
              };
              id ? await api('/proof/' + id, 'PUT', body) : await api('/proof', 'POST', body);
              closeModal();
              loadProof();
              toast('Item saved!');
            } catch (e) {
              toast(e.message, true);
            }
          }

          // ── FAQs ───────────────────────────────────────────────────────────────
          async function loadFaqs() {
            try {
              const { faqs } = await api('/faqs');
              ST.faqs = faqs;
              $('faqs-list').innerHTML = faqs.length
                ? faqs
                    .map(
                      (f) => `
                <div class="li">
                  <div class="li-body">
                    <div class="li-title">${esc(f.question)}</div>
                    <div class="li-sub">${esc(f.answer).slice(0, 90)}...</div>
                  </div>
                  <div class="la">
                    <span class="badge ${f.visible ? 'ok' : 'off'}">${f.visible ? 'On' : 'Off'}</span>
                    <button class="lbtn" type="button" onclick="openFaq(${f.id})"><span class="material-icons-round mi">edit</span>Edit</button>
                    <button class="lbtn del" type="button" onclick="delItem('faqs',${f.id},loadFaqs)"><span class="material-icons-round mi">delete</span></button>
                  </div>
                </div>`
                    )
                    .join('')
                : '<div style="color:var(--text-faint);font-size:.8rem">No FAQs yet.</div>';
            } catch (e) {
              toast(e.message, true);
            }
          }
          async function openFaq(id) {
            const f = ST.faqs?.find((x) => x.id === id) || null;
            $('mbody').innerHTML = `
              <div class="modal-title">${f ? 'EDIT FAQ' : 'ADD FAQ'}</div>
              <div class="fgrid" style="margin-bottom:1rem">
                <div class="fg full"><label>Question</label><input id="m-q" value="${esc(f?.question || '')}"/></div>
                <div class="fg full"><label>Answer (supports &lt;strong&gt; &lt;em&gt;)</label><textarea id="m-a" style="min-height:90px">${esc(f?.answer || '')}</textarea></div>
                <div class="fg"><label>Order</label><input id="m-ord" type="number" value="${f?.order_idx || 0}"/></div>
                <div class="fg" style="padding-top:1rem"><div class="trow"><div class="tlbl">Visible</div><label class="tsw"><input type="checkbox" id="m-vis" ${f?.visible !== false ? 'checked' : ''}/><span class="tsl"></span></label></div></div>
              </div>
              <div class="brow"><button class="btn-s" type="button" onclick="saveFaq(${id || 'null'})"><span class="material-icons-round mi">save</span>Save</button><button class="btn-o" type="button" onclick="closeModal()">Cancel</button></div>`;
            openModal();
          }
          async function saveFaq(id) {
            try {
              const body = {
                question: val('m-q'),
                answer: val('m-a'),
                order_idx: parseInt(val('m-ord')) || 0,
                visible: chk('m-vis'),
              };
              id ? await api('/faqs/' + id, 'PUT', body) : await api('/faqs', 'POST', body);
              closeModal();
              loadFaqs();
              toast('FAQ saved!');
            } catch (e) {
              toast(e.message, true);
            }
          }

          // ── Contact ────────────────────────────────────────────────────────────
          async function loadContact() {
            try {
              const { settings } = await api('/settings');
              ST.settings = settings;
              const c = settings.contact || {};
              setVal('ct-email', c.email);
              setVal('ct-li', c.linkedin);
              setVal('ct-gh', c.github);
              setVal('ct-main-site', c.main_site);
              setVal('ct-intro', c.intro_text);
              setVal('ct-avail-txt', c.availability_badge);
              setChk('ct-form', c.form_enabled !== false);
              setChk('ct-avail', c.availability_visible !== false);
            } catch (e) {
              toast(e.message, true);
            }
          }
          async function saveContact() {
            try {
              const s = ST.settings || (await api('/settings')).settings || {};
              const payload = {
                contact: {
                  ...(s.contact || {}),
                  email: val('ct-email'),
                  linkedin: val('ct-li'),
                  github: val('ct-gh'),
                  main_site: val('ct-main-site'),
                  intro_text: val('ct-intro'),
                  form_enabled: chk('ct-form'),
                  availability_visible: chk('ct-avail'),
                  availability_badge: val('ct-avail-txt'),
                },
              };
              const res = await api('/settings', 'POST', payload);
              if (res.ok && Array.isArray(res.saved) && res.saved.includes('contact')) {
                ST.settings = { ...s, ...payload };
                toast('Contact settings saved!');
              } else {
                toast(res.error || 'Failed to save contact settings', true);
              }
            } catch (e) {
              toast(e.message, true);
            }
          }

          // ── Inbox ──────────────────────────────────────────────────────────────
          async function loadInbox() {
            try {
              const { submissions } = await api('/inbox');
              const unreadCount = submissions.filter((s) => !s.read).length;
              const b = $('ubadge');
              if (b) {
                if (unreadCount > 0) {
                  b.textContent = unreadCount;
                  b.style.display = 'inline-block';
                } else {
                  b.style.display = 'none';
                }
              }
              if (!submissions.length) {
                $('inbox-content').innerHTML =
                  '<div style="color:var(--text-faint);font-size:.8rem;padding:1rem">No messages yet.</div>';
                return;
              }
              $('inbox-content').innerHTML = submissions
                .map(
                  (s) => `
                <div class="sub-card ${s.read ? '' : 'unread'}">
                  <div class="sub-hd">
                    <div><div class="sub-name">${esc(s.name)}</div><div class="sub-email">${esc(s.email)}</div></div>
                    <div style="text-align:right">
                      <div class="sub-date">${esc(s.created_at?.slice(0, 16) || '')}</div>
                      ${!s.read ? `<button class="lbtn" type="button" style="margin-top:.3rem" onclick="markRead(${s.id})"><span class="material-icons-round mi">mark_email_read</span>Mark read</button>` : ''}
                    </div>
                  </div>
                  ${s.subject ? `<div class="sub-subj">Re: ${esc(s.subject)}</div>` : ''}
                  <div class="sub-msg">${esc(s.message)}</div>
                </div>`
                )
                .join('');
            } catch (e) {
              toast(e.message, true);
            }
          }
          async function markRead(id) {
            try {
              await api('/inbox/' + id + '/read', 'POST');
              loadInbox();
            } catch (e) {
              toast(e.message, true);
            }
          }

          // ── Sections ───────────────────────────────────────────────────────────
          async function loadSections() {
            try {
              const { sections } = await api('/sections');
              ST.sections = sections;
              $('sections-list').innerHTML = sections
                .map(
                  (s, i) => `
                <div class="sec-item" draggable="true" data-id="${esc(s.id)}" data-label="${esc(s.label)}" data-idx="${i}">
                  <span class="material-icons-round sec-drag">drag_indicator</span>
                  <span class="sec-label">${esc(s.label)}</span>
                  <span class="sec-id">${esc(s.id)}</span>
                  <label class="tsw" style="margin-left:auto"><input type="checkbox" id="sec-vis-${esc(s.id)}" ${s.visible ? 'checked' : ''}/><span class="tsl"></span></label>
                </div>`
                )
                .join('');
              initDrag();
            } catch (e) {
              toast(e.message, true);
            }
          }
          function initDrag() {
            const items = $('sections-list').querySelectorAll('.sec-item');
            let dragged = null;
            items.forEach((el) => {
              el.addEventListener('dragstart', () => {
                dragged = el;
                el.style.opacity = '.4';
              });
              el.addEventListener('dragend', () => {
                dragged = null;
                el.style.opacity = '';
              });
              el.addEventListener('dragover', (e) => {
                e.preventDefault();
                if (dragged && el !== dragged) el.parentNode.insertBefore(dragged, el);
              });
            });
          }
          async function saveSections() {
            try {
              const items = [...$('sections-list').querySelectorAll('.sec-item')].map((el, i) => ({
                id: el.dataset.id,
                label: el.dataset.label || el.dataset.id,
                order_idx: i + 1,
                visible: el.querySelector('input[type="checkbox"]')?.checked ? 1 : 0,
              }));
              await api('/sections', 'PUT', { sections: items });
              toast('Sections order & visibility saved!');
            } catch (e) {
              toast(e.message, true);
            }
          }

          // ── SEO ────────────────────────────────────────────────────────────────
          async function loadSeo() {
            try {
              const { settings } = await api('/settings');
              ST.settings = settings;
              const s = settings.seo || {};
              setVal('seo-title', s.title);
              setVal('seo-desc', s.description);
              setVal('seo-keywords', s.keywords);
              setVal('seo-ogt', s.og_title);
              setVal('seo-ogi', s.og_image);
              setVal('seo-ogd', s.og_description);
              setVal('seo-can', s.canonical);
              setChk('seo-jsonld', s.json_ld_enabled !== false);
              setChk('seo-reviews-jsonld', Boolean(s.reviews_jsonld));
              const sel = $('seo-robots');
              if (sel) {
                [...sel.options].forEach((o) => (o.selected = o.value === (s.robots || sel.options[0].value)));
              }
            } catch (e) {
              toast(e.message, true);
            }
          }
          async function saveSeo() {
            try {
              const s = ST.settings || (await api('/settings')).settings || {};
              const payload = {
                seo: {
                  ...(s.seo || {}),
                  title: val('seo-title'),
                  description: val('seo-desc'),
                  keywords: val('seo-keywords'),
                  og_title: val('seo-ogt'),
                  og_image: val('seo-ogi'),
                  og_description: val('seo-ogd'),
                  canonical: val('seo-can'),
                  robots: val('seo-robots'),
                  json_ld_enabled: chk('seo-jsonld'),
                  reviews_jsonld: chk('seo-reviews-jsonld'),
                },
              };
              const res = await api('/settings', 'POST', payload);
              if (res.ok && Array.isArray(res.saved) && res.saved.includes('seo')) {
                ST.settings = { ...s, ...payload };
                toast('SEO settings saved!');
              } else {
                toast(res.error || 'Failed to save SEO settings', true);
              }
            } catch (e) {
              toast(e.message, true);
            }
          }

          // ── Theme ──────────────────────────────────────────────────────────────
          async function loadTheme() {
            try {
              const { settings } = await api('/settings');
              ST.settings = settings;
              const t = settings.theme || {};
              const sel = $('th-default');
              if (sel) [...sel.options].forEach((o) => (o.selected = o.value === (t.default || 'dark')));
              const accSel = $('th-accent');
              if (accSel) [...accSel.options].forEach((o) => (o.selected = o.value === (t.accent || 'emerald')));
              const glowSel = $('th-glow');
              const glowVal = t.glow_intensity || t.neon_intensity || 'subtle';
              if (glowSel) [...glowSel.options].forEach((o) => (o.selected = o.value === glowVal));
              setChk('th-toggle', t.user_toggle_enabled !== false);
            } catch (e) {
              toast(e.message, true);
            }
          }
          async function saveTheme() {
            try {
              const s = ST.settings || (await api('/settings')).settings || {};
              const glow = val('th-glow') || 'subtle';
              const payload = {
                theme: {
                  ...(s.theme || {}),
                  default: val('th-default') || 'dark',
                  accent: val('th-accent') || 'emerald',
                  glow_intensity: glow,
                  neon_intensity: glow,
                  user_toggle_enabled: chk('th-toggle'),
                },
              };
              const res = await api('/settings', 'POST', payload);
              if (res.ok && Array.isArray(res.saved) && res.saved.includes('theme')) {
                ST.settings = { ...s, ...payload };
                toast('Theme saved!');
              } else {
                toast(res.error || 'Server did not confirm theme save', true);
              }
            } catch (e) {
              toast(e.message, true);
            }
          }

          // ── Security & 2FA ─────────────────────────────────────────────────────
          async function changePw() {
            const cur = val('pw-cur'),
              nw = val('pw-new'),
              con = val('pw-con');
            if (!cur || !nw || !con) {
              toast('All fields are required.', true);
              return;
            }
            if (nw !== con) {
              toast('New passwords do not match.', true);
              return;
            }
            if (nw.length < 8) {
              toast('Password must be at least 8 characters.', true);
              return;
            }
            try {
              await api('/change-password', 'POST', { current_password: cur, new_password: nw });
              $('pw-cur').value = '';
              $('pw-new').value = '';
              $('pw-con').value = '';
              toast('Password changed & other sessions revoked!');
            } catch (e) {
              toast(e.message, true);
            }
          }

          async function load2FAStatus() {
            try {
              const st = await api('/2fa/status');
              const box = $('twofa-status-box');
              const setupArea = $('twofa-setup-area');
              const disableArea = $('twofa-disable-area');
              const initRow = $('twofa-init-row');
              setupArea.style.display = 'none';
              if (st.enabled) {
                box.innerHTML =
                  '<span class="badge ok">2FA ENABLED</span> ' +
                  (st.env_enforced
                    ? 'Enforced via Worker Secret (ADMIN_TOTP_SECRET).'
                    : 'Authenticator 2FA is active on your account.');
                disableArea.style.display = st.db_enabled ? 'block' : 'none';
                initRow.style.display = 'none';
              } else {
                box.innerHTML =
                  '<span class="badge off">2FA DISABLED</span> Protect your admin login with Google Authenticator or Authy.';
                disableArea.style.display = 'none';
                initRow.style.display = 'flex';
              }
            } catch (e) {
              toast(e.message, true);
            }
          }

          async function start2FASetup() {
            try {
              const res = await api('/2fa/setup', 'POST');
              $('twofa-secret-display').textContent = res.secret;
              $('twofa-setup-area').style.display = 'block';
              $('twofa-init-row').style.display = 'none';
            } catch (e) {
              toast(e.message, true);
            }
          }

          async function enable2FA() {
            const code = val('twofa-code-in');
            if (!code || code.length !== 6) {
              toast('Enter the 6-digit code from your Authenticator app.', true);
              return;
            }
            try {
              await api('/2fa/enable', 'POST', { code });
              $('twofa-code-in').value = '';
              toast('2FA Enabled successfully!');
              load2FAStatus();
            } catch (e) {
              toast(e.message, true);
            }
          }

          async function disable2FA() {
            const pw = val('twofa-pw-disable');
            if (!pw) {
              toast('Enter your current password to disable 2FA.', true);
              return;
            }
            try {
              await api('/2fa/disable', 'POST', { current_password: pw });
              $('twofa-pw-disable').value = '';
              toast('2FA Disabled.');
              load2FAStatus();
            } catch (e) {
              toast(e.message, true);
            }
          }

          // ── Backup ─────────────────────────────────────────────────────────────
          async function doExport() {
            try {
              const data = await api('/backup/export');
              const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
              const url = URL.createObjectURL(blob);
              const a = document.createElement('a');
              a.href = url;
              a.download = 'portfolio-backup-' + new Date().toISOString().slice(0, 10) + '.json';
              a.click();
              URL.revokeObjectURL(url);
              toast('Backup downloaded!');
            } catch (e) {
              toast(e.message, true);
            }
          }
          async function doImport() {
            const file = $('restore-file')?.files?.[0];
            if (!file) {
              toast('Please select a backup file.', true);
              return;
            }
            if (!confirm('This will overwrite all current data. Are you sure?')) return;
            try {
              const text = await file.text();
              const data = JSON.parse(text);
              await api('/backup/import', 'POST', data);
              toast('Backup restored! Reloading...');
              setTimeout(() => location.reload(), 1500);
            } catch (e) {
              toast('Restore failed: ' + e.message, true);
            }
          }

          async function delItem(type, id, reload) {
            if (!confirm('Delete this item?')) return;
            try {
              await api('/' + type + '/' + id, 'DELETE');
              reload();
              toast('Deleted.');
            } catch (e) {
              toast(e.message, true);
            }
          }

          loadDash();
        </script>
      </>
    )
  }
</AdminLayout>
