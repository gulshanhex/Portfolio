                  <div class="fg">
                    <label>Primary CTA Label</label>
                    <input id="h-cta1l" placeholder="Start a project" />
                  </div>
                  <div class="fg">
                    <label>Primary CTA URL</label>
                    <input id="h-cta1u" placeholder="#contact" />
                  </div>
                  <div class="fg">
                    <label>Secondary CTA Label</label>
                    <input id="h-cta2l" placeholder="View work" />
                  </div>
                  <div class="fg">
                    <label>Secondary CTA URL</label>
                    <input id="h-cta2u" placeholder="#projects" />
                  </div>
