                <div>
                  <strong style="color:var(--lime)">Experience, Education &amp; Projects</strong> — Timeline entries and
                  filterable project showcase with <code>/work/[slug]</code> case studies
                </div>
                <div>
                  <strong style="color:var(--lime)">Proof &amp; FAQs</strong> — Organizations, testimonials, and AEO FAQ
                  items
                </div>
                <div>
                  <strong style="color:var(--lime)">Security &amp; 2FA</strong> — Change password, enable TOTP 2FA, and
                  configure optional <code>ADMIN_ACCESS_KEY</code> secret in Worker settings
                </div>
              </div>
            </div>
          </div>
        </div>

        <div id="toast" role="status">
          <span class="material-icons-round mi" id="t-ico">
            check_circle
          </span>
          <span id="t-msg" />
        </div>

        <div id="ov">
          <div id="modal">
            <button class="mc" type="button" onclick="closeModal()" aria-label="Close modal">
              <span class="material-icons-round mi">close</span>
            </button>
            <div id="mbody" />
          </div>
        </div>

        <div id="gk-csrf" data-token={csrfToken} hidden></div>
        <script is:inline>
          // NOTE: no define:vars here. Astro wraps define:vars scripts in an IIFE, which hides every
          // function from the inline onclick="..." handlers used throughout this panel.
          const A = '/api/admin';
          const CSRF_TOKEN = document.getElementById('gk-csrf').dataset.token;
          let ST = {};

          function closeSidebar() {
            document.getElementById('sb')?.classList.remove('open');
            document.getElementById('sb-overlay')?.classList.remove('open');
          }

          function go(id) {
            closeSidebar();
            document.querySelectorAll('.panel').forEach((p) => p.classList.remove('active'));
            document.querySelectorAll('.sbl').forEach((l) => l.classList.remove('active'));
            const panel = document.getElementById('p-' + id);
            if (panel) panel.classList.add('active');
            const btn = document.querySelector('[data-p="' + id + '"]');
            if (btn) btn.classList.add('active');
            const TB_TITLES = { ui: 'Interface Text', copy: 'Section Copy', faqs: 'FAQs', seo: 'SEO', global: 'Global Settings', hero: 'Hero & About' };
            document.getElementById('tb-title').textContent = (TB_TITLES[id] || id.replace(/-/g, ' ')).toUpperCase();
            const loaders = {
              dashboard: loadDash,
              inbox: loadInbox,
              copy: loadCopy,
              ui: loadUiStrings,
              sections: loadSections,
              skills: loadSkills,
              services: loadSvcs,
              experience: loadXp,
              education: loadEdu,
              projects: loadProj,
              proof: loadProof,
              faqs: loadFaqs,
              global: loadGlobal,
              hero: loadHero,
              contact: loadContact,
              seo: loadSeo,
              theme: loadTheme,
              security: load2FAStatus,
            };
            if (loaders[id]) loaders[id]();
          }

          document.querySelectorAll('.sbl').forEach((b) => b.addEventListener('click', () => go(b.dataset.p)));
          document.getElementById('ham')?.addEventListener('click', () => {
            document.getElementById('sb')?.classList.toggle('open');
            document.getElementById('sb-overlay')?.classList.toggle('open');
          });
          document.getElementById('sb-overlay')?.addEventListener('click', closeSidebar);

          const $ = (id) => document.getElementById(id);
          const val = (id) => $(id)?.value?.trim() || '';
          const setVal = (id, v) => {
            if ($(id)) $(id).value = v ?? '';
          };
          const setChk = (id, v) => {
            if ($(id)) $(id).checked = Boolean(v);
          };
          const chk = (id) => Boolean($(id)?.checked);
          const esc = (s) =>
            String(s || '')
              .replace(/&/g, '&amp;')
              .replace(/</g, '&lt;')
              .replace(/>/g, '&gt;')
              .replace(/"/g, '&quot;');

          function toast(msg, err = false) {
            const t = $('toast');
            t.className = 'show' + (err ? ' err' : '');
            $('t-ico').textContent = err ? 'error' : 'check_circle';
            $('t-msg').textContent = msg;
            clearTimeout(t._t);
            t._t = setTimeout(() => (t.className = ''), 3500);
          }

          async function api(path, method = 'GET', body = null) {
            const opts = {
              method,
              headers: {
                'Content-Type': 'application/json',
                'X-CSRF-Token': CSRF_TOKEN,
              },
            };
            if (body) opts.body = JSON.stringify(body);
            const res = await fetch(A + path, opts);
            const data = await res.json().catch(() => ({}));
            if (!res.ok) throw new Error(data.error || 'Request failed');
            return data;
          }

          function openModal() {
            $('ov').classList.add('open');
          }
          function closeModal() {
            $('ov').classList.remove('open');
          }
          $('ov')?.addEventListener('click', (e) => {
            if (e.target === $('ov')) closeModal();
          });

          $('logout-btn')?.addEventListener('click', async () => {
            await fetch('/admin/logout', {
              method: 'POST',
              headers: { 'X-CSRF-Token': CSRF_TOKEN },
            });
            location.href = '/admin';
          });

          async function loadDash() {
            try {
              const { stats, settings } = await api('/dashboard');
              ST.settings = settings;
              $('ds-proj').textContent = stats.projects;
              $('ds-exp').textContent = stats.experiences;
              $('ds-msgs').textContent = stats.submissions;
              $('ds-unread').textContent = stats.unread;
              const b = $('ubadge');
              if (b) {
                if (stats.unread > 0) {
                  b.textContent = stats.unread;
                  b.style.display = 'inline-block';
                } else {
                  b.style.display = 'none';
                }
              }
              const g = settings.global || {};
              const c = settings.contact || {};
              const th = settings.theme || {};
              $('dash-info').innerHTML =
                '<div>Domain: <strong style="color:var(--text)">' +
                esc(g.portfolio || 'not set') +
                '</strong></div>' +
                '<div>Resume: <strong style="color:var(--text)">' +
                (c.resume_url ? 'Configured ✓' : 'Not set') +
                '</strong></div>' +
                '<div>Theme: <strong style="color:var(--text)">' +
                esc(th.default || 'dark') +
                ' · ' +
                esc(th.accent || 'emerald') +
                ' (' +
                esc(th.glow_intensity || th.neon_intensity || 'subtle') +
                ' glow)</strong></div>' +
                '<div>Contact Form: <strong style="color:var(--text)">' +
                (c.form_enabled !== false ? 'Enabled' : 'Disabled') +
                '</strong></div>';
            } catch (e) {
              toast(e.message, true);
            }
          }

          async function loadGlobal() {
            try {
              const { settings } = await api('/settings');
              ST.settings = settings;
              const g = settings.global || {},
                nav = settings.nav || {},
                c = settings.contact || {};
              setVal('g-name', g.name);
              setVal('g-site-name', g.site_name);
              setVal('g-tagline', g.tagline);
              setVal('g-location', g.location);
              setVal('g-footer', g.footer_text);
              setVal('g-domain', g.domain);
              setVal('g-portfolio', g.portfolio);
              setVal('g-proj-sub', g.projects_subdomain);
              setVal('g-resume', c.resume_url);
              setVal('g-resume-lbl', nav.resume_label || 'Resume');
              setChk('g-resume-nav', nav.show_resume !== false);
              ST.footerLinks = Array.isArray(g.footer_links) && g.footer_links.length
                ? JSON.parse(JSON.stringify(g.footer_links))
                : [
                    { label: 'Work Archive', url: '/work' },
                    { label: 'LLMs.txt', url: '/llms.txt' },
                    { label: 'Sitemap', url: '/sitemap.xml' },
                  ];
              renderFooterLinks();
            } catch (e) {
              toast(e.message, true);
            }
          }

          function renderFooterLinks() {
            const box = $('footer-links-ed');
            if (!box) return;
            box.innerHTML = (ST.footerLinks || [])
              .map(
                (lnk, i) => `
              <div class="fgrid" style="margin-bottom:.6rem;padding:.7rem;border:1px solid var(--bdr-s);align-items:end">
                <div class="fg"><label>Label</label><input id="fl-lbl-${i}" value="${esc(lnk.label)}" placeholder="Work Archive"/></div>
                <div class="fg"><label>URL</label><input id="fl-url-${i}" value="${esc(lnk.url)}" placeholder="/work"/></div>
                <div class="fg full" style="display:flex;gap:.4rem;flex-direction:row">
                  <button class="lbtn" type="button" onclick="moveFooterLink(${i},-1)" ${i === 0 ? 'disabled' : ''}>↑ Up</button>
                  <button class="lbtn" type="button" onclick="moveFooterLink(${i},1)" ${i === (ST.footerLinks.length - 1) ? 'disabled' : ''}>↓ Down</button>
                  <button class="btn-d" type="button" onclick="rmFooterLink(${i})" style="margin-left:auto"><span class="material-icons-round mi">delete</span>Remove</button>
                </div>
              </div>`
              )
              .join('');
          }

          function collectFooterLinks() {
            return (ST.footerLinks || [])
              .map((_, i) => ({
                label: val('fl-lbl-' + i),
                url: val('fl-url-' + i) || '#',
              }))
              .filter((x) => x.label);
          }

          function addFooterLink() {
            ST.footerLinks = collectFooterLinks();
            ST.footerLinks.push({ label: '', url: '/' });
            renderFooterLinks();
          }

          function rmFooterLink(i) {
            ST.footerLinks = collectFooterLinks();
            ST.footerLinks.splice(i, 1);
            renderFooterLinks();
          }

          function moveFooterLink(i, dir) {
            ST.footerLinks = collectFooterLinks();
            const target = i + dir;
            if (target < 0 || target >= ST.footerLinks.length) return;
            const tmp = ST.footerLinks[i];
            ST.footerLinks[i] = ST.footerLinks[target];
            ST.footerLinks[target] = tmp;
            renderFooterLinks();
          }

          async function saveGlobal() {
            try {
              const s = ST.settings || (await api('/settings')).settings || {};
              const payload = {
                global: {
                  ...(s.global || {}),
                  name: val('g-name'),
                  site_name: val('g-site-name'),
                  tagline: val('g-tagline'),
                  location: val('g-location'),
                  footer_text: val('g-footer'),
                  domain: val('g-domain'),
                  portfolio: val('g-portfolio'),
                  projects_subdomain: val('g-proj-sub'),
                  footer_links: collectFooterLinks(),
                },
                nav: {
                  ...(s.nav || {}),
                  show_resume: chk('g-resume-nav'),
                  resume_label: val('g-resume-lbl') || 'Resume',
                },
                contact: { ...(s.contact || {}), resume_url: val('g-resume') },
              };
              const res = await api('/settings', 'POST', payload);
              if (res.ok && Array.isArray(res.saved) && res.saved.includes('global')) {
                ST.settings = { ...s, ...payload };
                toast('Global settings saved!');
              } else {
                toast(res.error || 'Failed to save global settings', true);
              }
            } catch (e) {
              toast(e.message, true);
            }
          }

          async function loadCopy() {
            try {
              if (!ST.settings) {
                const { settings } = await api('/settings');
                ST.settings = settings;
              }
              const cp = ST.settings.copy || {};
              setVal('cp-about-eye', cp.about_eyebrow || '');
              setVal('cp-about-title', cp.about_title || '');
              setVal('cp-about-sub', cp.about_subtitle || '');

              setVal('cp-services-eye', cp.services_eyebrow || '');
              setVal('cp-services-title', cp.services_title || '');
              setVal('cp-services-sub', cp.services_subtitle || '');

              setVal('cp-skills-eye', cp.skills_eyebrow || '');
              setVal('cp-skills-title', cp.skills_title || '');
              setVal('cp-skills-sub', cp.skills_subtitle || '');

              setVal('cp-xp-eye', cp.experience_eyebrow || '');
              setVal('cp-xp-title', cp.experience_title || '');
              setVal('cp-xp-sub', cp.experience_subtitle || '');

              setVal('cp-edu-eye', cp.education_eyebrow || '');
              setVal('cp-edu-title', cp.education_title || '');
              setVal('cp-edu-sub', cp.education_subtitle || '');

              setVal('cp-projects-eye', cp.projects_eyebrow || '');
              setVal('cp-projects-title', cp.projects_title || '');
              setVal('cp-projects-sub', cp.projects_subtitle || '');

              setVal('cp-proof-eye', cp.proof_eyebrow || '');
              setVal('cp-proof-title', cp.proof_title || '');
              setVal('cp-proof-sub', cp.proof_subtitle || '');

              setVal('cp-faq-eye', cp.faq_eyebrow || '');
              setVal('cp-faq-title', cp.faq_title || '');
              setVal('cp-faq-sub', cp.faq_subtitle || '');

              setVal('cp-contact-eye', cp.contact_eyebrow || '');
              setVal('cp-contact-title', cp.contact_title || '');
              setVal('cp-contact-sub', cp.contact_subtitle || '');
            } catch (e) {
              toast(e.message, true);
            }
          }

          async function saveCopy() {
            try {
              const body = {
                about_eyebrow: $('cp-about-eye').value.trim(),
                about_title: $('cp-about-title').value.trim(),
                about_subtitle: $('cp-about-sub').value.trim(),

                services_eyebrow: $('cp-services-eye').value.trim(),
                services_title: $('cp-services-title').value.trim(),
                services_subtitle: $('cp-services-sub').value.trim(),

                skills_eyebrow: $('cp-skills-eye').value.trim(),
                skills_title: $('cp-skills-title').value.trim(),
                skills_subtitle: $('cp-skills-sub').value.trim(),

                experience_eyebrow: $('cp-xp-eye').value.trim(),
                experience_title: $('cp-xp-title').value.trim(),
                experience_subtitle: $('cp-xp-sub').value.trim(),

                education_eyebrow: $('cp-edu-eye').value.trim(),
                education_title: $('cp-edu-title').value.trim(),
                education_subtitle: $('cp-edu-sub').value.trim(),

                projects_eyebrow: $('cp-projects-eye').value.trim(),
                projects_title: $('cp-projects-title').value.trim(),
                projects_subtitle: $('cp-projects-sub').value.trim(),

                proof_eyebrow: $('cp-proof-eye').value.trim(),
                proof_title: $('cp-proof-title').value.trim(),
                proof_subtitle: $('cp-proof-sub').value.trim(),

                faq_eyebrow: $('cp-faq-eye').value.trim(),
                faq_title: $('cp-faq-title').value.trim(),
                faq_subtitle: $('cp-faq-sub').value.trim(),

                contact_eyebrow: $('cp-contact-eye').value.trim(),
                contact_title: $('cp-contact-title').value.trim(),
                contact_subtitle: $('cp-contact-sub').value.trim(),
              };

              const res = await api('/settings', 'POST', { copy: body });
              if (res.ok && Array.isArray(res.saved) && res.saved.includes('copy')) {
                ST.settings = ST.settings || {};
                ST.settings.copy = body;
                toast('Section copy saved successfully');
              } else {
                toast(res.error || 'Server did not confirm copy save', true);
              }
            } catch (e) {
              toast(e.message, true);
            }
          }

          // ── Interface Text Panel (Registry-Driven) ─────────────────────────────
          async function loadUiStrings() {
            try {
              const { settings } = await api('/settings');
              ST.settings = settings;
              const ui = settings.ui || {};
              document.querySelectorAll('[data-ui-key]').forEach((el) => {
                const k = el.getAttribute('data-ui-key');
                const defVal = el.getAttribute('data-ui-default') || '';
                const cur = ui[k];
                el.value = cur !== undefined && cur !== defVal ? cur : '';
              });
            } catch (e) {
              toast(e.message, true);
            }
          }

          function resetUiField(key) {
            const el = document.getElementById('ui-in-' + key);
            if (el) el.value = '';
          }

          function resetAllUiStrings() {
            if (!confirm('Reset all interface text fields to their default values? Click Save Interface Text afterwards to persist.')) return;
            document.querySelectorAll('[data-ui-key]').forEach((el) => {
              el.value = '';
            });
            toast('All fields reset to defaults. Click Save to apply.');
          }

          function filterUiStrings() {
            const q = ($('ui-search-in')?.value || '').trim().toLowerCase();
            document.querySelectorAll('.ui-group-details').forEach((grp) => {
              let visibleInGroup = 0;
              grp.querySelectorAll('[data-ui-row]').forEach((row) => {
                const hay = row.getAttribute('data-ui-search') || '';
                const valText = (row.querySelector('[data-ui-key]')?.value || '').toLowerCase();
                const match = !q || hay.includes(q) || valText.includes(q);
                row.style.display = match ? '' : 'none';
                if (match) visibleInGroup++;
              });
              grp.style.display = visibleInGroup > 0 ? '' : 'none';
              if (q && visibleInGroup > 0) grp.open = true;
            });
          }

          async function saveUiStrings() {
            try {
              const nonDefaultUi = {};
              document.querySelectorAll('[data-ui-key]').forEach((el) => {
                const k = el.getAttribute('data-ui-key');
                const defVal = el.getAttribute('data-ui-default') || '';
                const v = (el.value || '').trim();
                if (k && v !== '' && v !== defVal) {
                  nonDefaultUi[k] = v;
                }
              });
              const res = await api('/settings', 'POST', { ui: nonDefaultUi });
              if (res.ok && Array.isArray(res.saved) && res.saved.includes('ui')) {
                ST.settings = ST.settings || {};
                ST.settings.ui = nonDefaultUi;
                toast('Interface text saved (' + Object.keys(nonDefaultUi).length + ' custom overrides)!');
              } else {
                toast(res.error || 'Server did not confirm interface text save', true);
              }
            } catch (e) {
              toast(e.message, true);
            }
          }

          const HERO_VISUAL_MAP = [
            ['hv-api-title', 'hero_visual.api_title'],
            ['hv-api-badge', 'hero_visual.api_badge'],
            ['hv-s1l', 'hero_visual.stat1_label'],
            ['hv-s1v', 'hero_visual.stat1_value'],
            ['hv-s2l', 'hero_visual.stat2_label'],
            ['hv-s2v', 'hero_visual.stat2_value'],
            ['hv-s3l', 'hero_visual.stat3_label'],
            ['hv-s3v', 'hero_visual.stat3_value'],
            ['hv-conn', 'hero_visual.connector_text'],
            ['hv-bot-name', 'hero_visual.bot_name'],
            ['hv-bot-status', 'hero_visual.bot_status'],
            ['hv-bot-sender', 'hero_visual.bot_sender'],
            ['hv-bot-msg1', 'hero_visual.bot_msg1'],
            ['hv-code', 'hero_visual.code_snippet'],
            ['hv-user-msg', 'hero_visual.user_msg'],
            ['hv-bot-reply', 'hero_visual.bot_reply'],
            ['hv-input-ph', 'hero_visual.input_placeholder'],
            ['hv-send-btn', 'hero_visual.send_btn'],
            ['hv-caption', 'hero_visual.caption'],
          ];

          async function loadHero() {
            try {
              const { settings } = await api('/settings');
              ST.settings = settings;
              const h = settings.hero || {},
                a = settings.about || {},
                ui = settings.ui || {};
              setVal('h-ln1', h.headline_line1);
              setVal('h-ln2', h.headline_line2);
              setVal('h-headline', h.headline);
              setVal('h-subheadline', h.subheadline);
              setChk('h-visual', h.show_visual !== false);
              const vSel = $('h-visual-variant');
              if (vSel) {
                [...vSel.options].forEach((o) => (o.selected = o.value === (h.visual_variant || 'chat+chart')));
              }
              setVal('h-role', h.role_text);
              setVal('h-status', h.status_label);
              setVal('h-chip', h.status_chip);
              setVal('h-cta1l', h.cta_primary_label);
              setVal('h-cta1u', h.cta_primary_url);
              setVal('h-cta2l', h.cta_secondary_label);
              setVal('h-cta2u', h.cta_secondary_url);
              for (const [inputId, uiKey] of HERO_VISUAL_MAP) {
                setVal(inputId, ui[uiKey] || '');
              }
              ST.stats = JSON.parse(JSON.stringify(h.quick_stats || []));
              ST.paras = JSON.parse(JSON.stringify(a.paragraphs || []));
              setVal('h-quote', a.quote);
              renderStats();
              renderParas();
            } catch (e) {
              toast(e.message, true);
            }
          }
          async function saveHero() {
            try {
              const s = ST.settings || (await api('/settings')).settings || {};
              const nextUi = { ...(s.ui || {}) };
              for (const [inputId, uiKey] of HERO_VISUAL_MAP) {
                const v = val(inputId);
                const regEl = document.getElementById('ui-in-' + uiKey);
                const defVal = regEl ? regEl.getAttribute('data-ui-default') || '' : '';
                if (v && v !== defVal) {
                  nextUi[uiKey] = v;
                } else {
                  delete nextUi[uiKey];
                }
              }
              const payload = {
                hero: {
                  ...(s.hero || {}),
                  headline_line1: val('h-ln1'),
                  headline_line2: val('h-ln2'),
                  headline: val('h-headline'),
                  subheadline: val('h-subheadline'),
                  show_visual: chk('h-visual'),
                  visual_variant: val('h-visual-variant') || 'chat+chart',
                  role_text: val('h-role'),
                  status_label: val('h-status'),
                  status_chip: val('h-chip'),
                  cta_primary_label: val('h-cta1l'),
                  cta_primary_url: val('h-cta1u'),
                  cta_secondary_label: val('h-cta2l'),
                  cta_secondary_url: val('h-cta2u'),
                  quick_stats: collectStats(),
                },
                about: {
                  ...(s.about || {}),
                  paragraphs: collectParas(),
                  quote: val('h-quote'),
                },
                ui: nextUi,
              };
              const res = await api('/settings', 'POST', payload);
              if (res.ok && Array.isArray(res.saved) && res.saved.includes('hero')) {
                ST.settings = { ...s, ...payload };
                toast('Hero, Visual & About saved!');
              } else {
                toast(res.error || 'Server did not confirm save', true);
              }
            } catch (e) {
              toast(e.message, true);
            }
          }
          function renderStats() {
            $('stats-ed').innerHTML = (ST.stats || [])
              .map(
                (s, i) => `
              <div class="fgrid" style="margin-bottom:.7rem;padding:.8rem;border:1px solid var(--bdr-s)">
                <div class="fg"><label>Value</label><input id="sv-${i}" value="${esc(s.value)}"/></div>
                <div class="fg"><label>Label</label><input id="sl-${i}" value="${esc(s.label)}"/></div>
                <div class="fg full"><label>Description</label><input id="sd-${i}" value="${esc(s.desc)}"/></div>
                <div class="fg"><button class="btn-d" type="button" onclick="rmStat(${i})"><span class="material-icons-round mi">delete</span>Remove</button></div>
              </div>`
              )
              .join('');
          }
          function addStat() {
            ST.stats = collectStats();
            ST.stats.push({ value: '', label: '', desc: '' });
            renderStats();
          }
          function rmStat(i) {
            ST.stats = collectStats();
            ST.stats.splice(i, 1);
            renderStats();
          }
          function collectStats() {
            return (ST.stats || []).map((_, i) => ({
              value: val('sv-' + i),
              label: val('sl-' + i),
              desc: val('sd-' + i),
            }));
          }
          function renderParas() {
            $('para-ed').innerHTML = (ST.paras || [])
              .map(
                (p, i) => `
              <div style="display:flex;gap:.5rem;margin-bottom:.5rem">
                <textarea id="pa-${i}" style="flex:1;min-height:60px;background:var(--bg);border:1px solid var(--bdr-s);color:var(--text);font-size:.78rem;padding:.55rem;outline:none;resize:vertical">${esc(p)}</textarea>
                <button class="btn-d" type="button" onclick="rmPara(${i})" style="padding:.3rem .5rem;height:fit-content"><span class="material-icons-round mi">delete</span></button>
              </div>`
              )
              .join('');
          }
          function addPara() {
            ST.paras = collectParas();
            ST.paras.push('');
            renderParas();
          }
          function rmPara(i) {
            ST.paras = collectParas();
