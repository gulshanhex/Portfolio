            </div>

            <!-- Section Copy Panel -->
            <div class="panel" id="p-copy">
              <div class="ph">
                <div class="ph-title">SECTION COPY &amp; HEADINGS</div>
                <div class="ph-sub">Customize eyebrows, headings, and subtitle text across every public section.</div>
              </div>

              <div class="fs">
                <div class="fs-title"><span class="material-icons-round mi">flag</span>About Section</div>
                <div class="fgrid">
                  <div class="fg"><label>Eyebrow</label><input id="cp-about-eye" placeholder="// ABOUT ME" /></div>
