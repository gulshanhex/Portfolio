---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { UI_STRINGS } from '../../lib/ui-strings';

const session = Astro.locals.adminSession;
const csrfToken = Astro.locals.csrfToken || '';
const url = new URL(Astro.request.url);
const loginError = url.searchParams.get('error') || '';
const username = session?.username || 'admin';

// Group UI_STRINGS by group name in order of appearance
const uiGroups: Array<{ group: string; items: typeof UI_STRINGS }> = [];
for (const item of UI_STRINGS) {
  let g = uiGroups.find((x) => x.group === item.group);
  if (!g) {
    g = { group: item.group, items: [] };
    uiGroups.push(g);
  }
  g.items.push(item);
}
---

<AdminLayout title={session ? 'Admin Dashboard · Portfolio' : 'Admin Login · Portfolio'}>
  {
    !session ? (
      <div class="login-screen">
        <div class="login-wrap">
          <div class="login-logo">
            GK<span>.</span>
          </div>
          <div class="login-sub">Portfolio Admin</div>
          <div class="login-box">
            <h1>SIGN IN</h1>
            {loginError && (
              <div class="login-err" role="alert">
                {loginError}
              </div>
            )}
            <form method="POST" action="/admin/login">
              <div class="fg" style="margin-bottom:1rem">
                <label for="un">Username</label>
                <input type="text" id="un" name="username" required autocomplete="username" autofocus maxlength="100" />
              </div>
              <div class="fg" style="margin-bottom:1rem">
                <label for="pw">Password</label>
                <input type="password" id="pw" name="password" required autocomplete="current-password" />
              </div>
              <div class="fg" style="margin-bottom:1.2rem">
                <label for="totp">2FA Code (if enabled)</label>
                <input
                  type="text"
                  id="totp"
                  name="totp_code"
                  inputmode="numeric"
                  pattern="[0-9]{6}"
                  maxlength="6"
                  placeholder="6-digit Authenticator code"
                  autocomplete="one-time-code"
                />
              </div>
              <button type="submit" class="btn-s" style="width:100%;justify-content:center;padding:.85rem">
                Sign In →
              </button>
            </form>
          </div>
          <div class="login-foot">
            <a href="/">← Back to portfolio</a> · <a href="/docs">Setup docs</a>
          </div>
        </div>
      </div>
    ) : (
      <>
