---
import { getEnv } from '../lib/env';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import { getAllSettings } from '../lib/db';
import { t } from '../lib/ui-strings';

const db = getEnv()?.DB;
const settings = await getAllSettings(db);
const g = settings.global || {};
const theme = settings.theme || {};
const name = g.name || 'Your Name';
const defaultTheme = theme.default || 'dark';
const accent = theme.accent || 'emerald';
const glowIntensity = theme.glow_intensity || theme.neon_intensity || 'subtle';

const errorCode = t(settings, 'error404.code');
const errorEyebrow = t(settings, 'error404.eyebrow');
const errorTitle = t(settings, 'error404.title');
const errorDesc = t(settings, 'error404.description');
const backHomeBtn = t(settings, 'error404.back_home_btn');
const goBackBtn = t(settings, 'error404.go_back_btn');

Astro.response.status = 404;
---

<BaseLayout
  title={`${errorCode} — ${errorTitle} · ${name}`}
  description={errorDesc}
  robots="noindex, nofollow"
  authorName={name}
  defaultTheme={defaultTheme}
  accent={accent}
  glowIntensity={glowIntensity}
  settings={settings}
>
  <main id="main-content" class="error-container">
    <div class="error-bg-code" aria-hidden="true">{errorCode}</div>
    <div class="error-eyebrow">{errorEyebrow}</div>
    <h1 class="error-title">{errorTitle}</h1>
    <p class="error-desc">{errorDesc}</p>
    <div class="error-actions">
      <Button variant="primary" size="md" href="/">
        <span>{backHomeBtn}</span>
        <span aria-hidden="true">→</span>
      </Button>
      <Button variant="secondary" size="md" href="javascript:history.back()">
        <span>{goBackBtn}</span>
      </Button>
    </div>
  </main>
</BaseLayout>

<style>
  .error-container {
    min-height: 85vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: var(--sp-6) var(--sp-5);
    position: relative;
    z-index: 2;
  }

  .error-bg-code {
    font-family: var(--ff-mono);
    font-size: clamp(6rem, 22vw, 16rem);
    font-weight: 800;
    line-height: 0.9;
    color: var(--accent);
    opacity: 0.06;
    position: absolute;
    user-select: none;
    pointer-events: none;
    z-index: -1;
  }

  .error-eyebrow {
    font-family: var(--ff-mono);
    font-size: var(--fs-xs);
    font-weight: 500;
    color: var(--accent);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: var(--sp-2);
  }

  .error-title {
    font-family: var(--ff-sans);
    font-size: var(--fs-3xl);
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--heading);
    margin-bottom: var(--sp-3);
  }

  .error-desc {
    font-family: var(--ff-sans);
    font-size: var(--fs-base);
    color: var(--muted);
    max-width: 480px;
    line-height: 1.6;
    margin-bottom: var(--sp-6);
  }

  .error-actions {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    flex-wrap: wrap;
    justify-content: center;
  }
</style>
