---
import SectionHeader from './ui/SectionHeader.astro';
import TimelineItem from './ui/TimelineItem.astro';
import { t } from '../lib/ui-strings';

interface ExperienceItem {
  id: number;
  badge_label: string;
  badge_type: string;
  icon: string;
  title: string;
  company: string;
  date_range: string;
  duration: string;
  location: string;
  bullet_points: string[];
  tags: string[];
}

interface Props {
  experiences: ExperienceItem[];
  copy?: Record<string, any>;
  sectionNum?: string;
  settings?: Record<string, any>;
}

const { experiences = [], copy = {}, settings = {} } = Astro.props;

const eyebrow = copy.experience_eyebrow || t(settings, 'experience.eyebrow_default');
const title = copy.experience_title || t(settings, 'experience.title_default');
const subtitle = copy.experience_subtitle || t(settings, 'experience.subtitle_default');
---

{
  experiences.length > 0 && (
    <section id="experience" class="experience-section" aria-labelledby="experience-title">
      <div class="experience-container">
        <div class="experience-layout">
          <div class="experience-intro">
            <SectionHeader eyebrow={eyebrow} title={title} subtitle={subtitle} />
          </div>

          <div class="experience-list">
            {experiences.map((x, i) => (
              <div class="rv" style={`transition-delay: ${i * 0.1}s`}>
                <TimelineItem
                  icon={x.icon || 'work'}
                  title={x.title}
                  organization={x.company}
                  dateRange={x.date_range}
                  duration={x.duration}
                  location={x.location}
                  badgeLabel={x.badge_label}
                  bulletPoints={x.bullet_points || []}
                  tags={x.tags || []}
                />
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>
  )
}

<style>
  .experience-section {
    padding: 48px 20px;
    background: var(--bg);
  }

  .experience-container {
    max-width: var(--max-w-content);
    margin: 0 auto;
  }

  .experience-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
    align-items: start;
  }

  .experience-list {
    width: 100%;
  }

  @media (min-width: 640px) {
    .experience-section {
      padding: 64px 28px;
    }
  }

  @media (min-width: 1024px) {
    .experience-section {
      padding: 80px 32px;
    }
    .experience-layout {
      grid-template-columns: minmax(0, 0.36fr) minmax(0, 0.64fr);
      gap: 48px;
    }
    .experience-intro {
      position: sticky;
      top: calc(var(--nav-height) + 32px);
    }
  }
</style>
