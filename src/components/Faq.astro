---
import SectionHeader from './ui/SectionHeader.astro';
import FaqItem from './ui/FaqItem.astro';
import { t } from '../lib/ui-strings';

interface FaqEntry {
  id: number;
  question: string;
  answer: string;
}

interface Props {
  faqs: FaqEntry[];
  copy?: Record<string, any>;
  sectionNum?: string;
  settings?: Record<string, any>;
}

const { faqs = [], copy = {}, settings = {} } = Astro.props;

const eyebrow = copy.faq_eyebrow || t(settings, 'faq.eyebrow_default');
const title = copy.faq_title || t(settings, 'faq.title_default');
const subtitle = copy.faq_subtitle || t(settings, 'faq.subtitle_default');
---

{
  faqs.length > 0 && (
    <section id="faq" class="faq-section" aria-labelledby="faq-title">
      <div class="faq-container">
        <div class="faq-layout">
          <div class="faq-intro">
            <SectionHeader eyebrow={eyebrow} title={title} subtitle={subtitle} />
          </div>

          <div class="faq-list">
            {faqs.map((fq, i) => (
              <div class="rv" style={`transition-delay: ${i * 0.06}s`}>
                <FaqItem question={fq.question} answer={fq.answer} />
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>
  )
}

<style>
  .faq-section {
    padding: 48px 20px;
    background: var(--bg);
  }

  .faq-container {
    max-width: var(--max-w-content);
    margin: 0 auto;
  }

  .faq-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
    align-items: start;
  }

  .faq-list {
    width: 100%;
  }

  @media (min-width: 640px) {
    .faq-section {
      padding: 64px 28px;
    }
  }

  @media (min-width: 1024px) {
    .faq-section {
      padding: 80px 32px;
    }
    .faq-layout {
      grid-template-columns: minmax(0, 0.36fr) minmax(0, 0.64fr);
      gap: 48px;
    }
    .faq-intro {
      position: sticky;
      top: calc(var(--nav-height) + 32px);
    }
  }
</style>
