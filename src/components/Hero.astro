---
import Button from './ui/Button.astro';
import Pill from './ui/Pill.astro';
import StatRow from './ui/StatRow.astro';
import HeroVisual from './ui/HeroVisual.astro';
import { sanitizeBasicHtml } from '../lib/db';
import { t } from '../lib/ui-strings';

interface Props {
  globalCfg: Record<string, any>;
  hero: Record<string, any>;
  contact: Record<string, any>;
  hasProjects?: boolean;
  settings?: Record<string, any>;
}

const { globalCfg = {}, hero = {}, contact = {}, hasProjects = true, settings = {} } = Astro.props;

const name = globalCfg.name || 'Your Name';
const tagline = globalCfg.tagline || 'Automation & AI Systems Engineer';

// Headline logic: new headline key with fallback to headline_line1 + headline_line2
const line12 = `${hero.headline_line1 || ''} ${hero.headline_line2 || ''}`.trim();
const headlineText = hero.headline || line12 || t(settings, 'hero.headline_default');

// Subheadline logic: new subheadline with fallback to role_text (rendered via sanitizeBasicHtml)
const subheadlineRaw = hero.subheadline || hero.role_text || t(settings, 'hero.subheadline_default');
const subheadlineHtml = sanitizeBasicHtml(subheadlineRaw);

const showAvailability = contact.availability_visible !== false;
const statusLabel = contact.availability_badge || hero.status_label || t(settings, 'hero.status_default');

// CTAs logic with target section safety
let primaryLabel = hero.cta_primary_label || t(settings, 'hero.cta_primary_default');
let primaryUrl = hero.cta_primary_url || '#contact';

let secondaryLabel =
  hero.cta_secondary_label || (hasProjects ? t(settings, 'hero.cta_secondary_work') : t(settings, 'hero.cta_secondary_services'));
let secondaryUrl = hero.cta_secondary_url || (hasProjects ? '#projects' : '#services');

// If target is #projects but no projects exist, redirect to #services
if (secondaryUrl === '#projects' && !hasProjects) {
  secondaryUrl = '#services';
  if (!hero.cta_secondary_label || hero.cta_secondary_label === 'View work') {
    secondaryLabel = t(settings, 'hero.cta_secondary_services');
  }
}
if (primaryUrl === '#projects' && !hasProjects) {
  primaryUrl = '#services';
  if (!hero.cta_primary_label) primaryLabel = t(settings, 'hero.cta_secondary_services');
}

// Avoid duplicate CTA buttons if both point to the same destination
const showSecondary = secondaryUrl !== primaryUrl;

const visualVariant: 'chat+chart' | 'chart' | 'none' =
  hero.visual_variant === 'chart' || hero.visual_variant === 'none' ? hero.visual_variant : 'chat+chart';
const showVisual = hero.show_visual !== false && visualVariant !== 'none';
const quickStats = Array.isArray(hero.quick_stats) ? hero.quick_stats : [];
const heroSectionAria = t(settings, 'hero.section_aria');
---

<section id="hero" class="hero-section" aria-label={heroSectionAria}>
  <div class="hero-container">
    <div class="hero-content">
      <!-- Eyebrow & Status Pill -->
      <div class="hero-top-meta">
        <span class="hero-eyebrow">// {tagline}</span>
        {showAvailability && (
          <Pill variant="status" pulse={true} size="sm">
            {statusLabel}
          </Pill>
        )}
      </div>

      <!-- Part A.6: Show the owner's name (global.name) as a clear line above the headline -->
      <div class="hero-owner-name">{name}</div>

      <!-- Exactly one h1 -->
      <h1 class="hero-headline">{headlineText}</h1>

      <!-- Outcome-focused subheadline -->
      <p class="hero-subheadline" set:html={subheadlineHtml} />

      <!-- Primary & Secondary CTAs -->
      <div class="hero-actions">
        <Button variant="primary" size="lg" href={primaryUrl} class="hero-btn-primary">
          <span>{primaryLabel}</span>
          <span aria-hidden="true">→</span>
        </Button>
        {showSecondary && (
          <Button variant="secondary" size="lg" href={secondaryUrl} class="hero-btn-secondary">
            <span>{secondaryLabel}</span>
            <span aria-hidden="true">{secondaryUrl.startsWith('http') ? '↗' : '→'}</span>
          </Button>
        )}
      </div>

      <!-- Compact 3-up Stats Row -->
      {quickStats.length > 0 && <StatRow stats={quickStats} class="hero-stats" />}
    </div>

    <!-- Hero Visual Artifact (Telegram Bot + Automation API) -->
    {showVisual && (
      <div class="hero-visual-wrapper">
        <HeroVisual settings={settings} variant={visualVariant} />
      </div>
    )}
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    padding: 36px 20px 52px;
    display: flex;
    align-items: center;
    background: var(--bg);
    overflow: hidden;
  }

  .hero-container {
    max-width: var(--max-w-content);
    width: 100%;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: 36px;
    align-items: center;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    z-index: 1;
    min-width: 0;
  }

  .hero-top-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: var(--sp-3);
  }

  .hero-eyebrow {
    font-family: var(--ff-mono);
    font-size: var(--fs-xs);
    font-weight: 500;
    color: var(--muted);
    letter-spacing: 0.03em;
  }

  .hero-owner-name {
    font-family: var(--ff-sans);
    font-size: var(--fs-md);
    font-weight: 700;
    color: var(--accent);
    letter-spacing: -0.01em;
    margin-bottom: var(--sp-2);
    line-height: 1.25;
  }

  .hero-headline {
    font-family: var(--ff-sans);
    font-size: var(--fs-hero);
    font-weight: 800;
    line-height: 1.08;
    color: var(--heading);
    letter-spacing: -0.035em;
    margin-bottom: var(--sp-4);
    max-width: 20ch;
  }

  .hero-subheadline {
    font-family: var(--ff-sans);
    font-size: var(--fs-md);
    line-height: 1.6;
    color: var(--muted);
    margin-bottom: var(--sp-5);
    max-width: 54ch;
  }

  .hero-subheadline :global(strong) {
    color: var(--heading);
    font-weight: 600;
  }

  .hero-subheadline :global(em) {
    color: var(--accent);
    font-style: normal;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
  }

  .hero-visual-wrapper {
    width: 100%;
    display: flex;
    justify-content: center;
    z-index: 1;
    min-width: 0;
  }

  /* Mobile (< 640px) */
  @media (max-width: 639px) {
    .hero-actions {
      flex-direction: column;
      width: 100%;
    }
    :global(.hero-btn-primary),
    :global(.hero-btn-secondary) {
      width: 100% !important;
      justify-content: center !important;
    }
  }

  /* Tablet (640px - 1023px) */
  @media (min-width: 640px) and (max-width: 1023px) {
    .hero-section {
      padding: 56px 28px 64px;
    }
    .hero-container {
      gap: 44px;
    }
  }

  /* Desktop (>= 1024px) */
  @media (min-width: 1024px) {
    .hero-section {
      min-height: min(calc(100svh - var(--nav-height)), 740px);
      padding: 72px 32px;
    }
    .hero-container {
      grid-template-columns: minmax(0, 1.12fr) minmax(0, 0.88fr);
      gap: 56px;
    }
  }
</style>
