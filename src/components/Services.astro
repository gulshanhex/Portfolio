---
import SectionHeader from './ui/SectionHeader.astro';
import ServiceCard from './ui/ServiceCard.astro';
import { t } from '../lib/ui-strings';

interface ServiceItem {
  id: number;
  icon: string;
  title: string;
  description: string;
  cta_label?: string | null;
  cta_url?: string | null;
  slug?: string | null;
}

interface Props {
  services: ServiceItem[];
  copy?: Record<string, any>;
  sectionNum?: string;
  settings?: Record<string, any>;
}

const { services = [], copy = {}, settings = {} } = Astro.props;

const eyebrow = copy.services_eyebrow || t(settings, 'services.eyebrow_default');
const title = copy.services_title || t(settings, 'services.title_default');
const subtitle = copy.services_subtitle || t(settings, 'services.subtitle_default');
---

{
  services.length > 0 && (
    <section id="services" class="services-section" aria-labelledby="services-title">
      <div class="services-container">
        <SectionHeader eyebrow={eyebrow} title={title} subtitle={subtitle} />

        <div class="services-grid">
          {services.map((s, i) => (
            <div class="rv" style={`transition-delay: ${i * 0.08}s`}>
              <ServiceCard
                icon={s.icon}
                title={s.title}
                description={s.description}
                ctaLabel={s.cta_label || undefined}
                ctaUrl={s.cta_url || undefined}
                slug={s.slug || undefined}
                settings={settings}
              />
            </div>
          ))}
        </div>
      </div>
    </section>
  )
}

<style>
  .services-section {
    padding: 48px 20px;
    background: var(--bg);
  }

  .services-container {
    max-width: var(--max-w-content);
    margin: 0 auto;
  }

  .services-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }

  @media (min-width: 640px) {
    .services-section {
      padding: 64px 28px;
    }
    .services-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 20px;
    }
  }

  @media (min-width: 1024px) {
    .services-section {
      padding: 80px 32px;
    }
    .services-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 24px;
    }
  }
</style>
