---
import SectionHeader from './ui/SectionHeader.astro';
import SkillGroup from './ui/SkillGroup.astro';

interface SkillPill {
  id?: number | string;
  label: string;
  is_hot?: boolean | number;
}

interface SkillItem {
  id: number;
  label: string;
  icon: string;
  pills: SkillPill[];
}

interface Props {
  skills: SkillItem[];
  copy?: Record<string, any>;
  sectionNum?: string;
}

const { skills = [], copy = {} } = Astro.props;

const eyebrow = copy.skills_eyebrow || '// TECH ARSENAL';
const title = copy.skills_title || 'What I work with.';
const subtitle = copy.skills_subtitle || 'A curated set of tools, languages, and systems built through production environments and hands-on engineering.';
---

{
  skills.length > 0 && (
    <section id="skills" class="skills-section" aria-labelledby="skills-title">
      <div class="skills-container">
        <SectionHeader eyebrow={eyebrow} title={title} subtitle={subtitle} />

        <div class="skills-grid">
          {skills.map((sk, i) => (
            <div class="rv" style={`transition-delay: ${i * 0.08}s`}>
              <SkillGroup
                icon={sk.icon}
                label={sk.label}
                pills={sk.pills || []}
              />
            </div>
          ))}
        </div>
      </div>
    </section>
  )
}

<style>
  .skills-section {
    padding: 48px 20px;
    background: var(--bg);
  }

  .skills-container {
    max-width: var(--max-w-content);
    margin: 0 auto;
  }

  .skills-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }

  @media (min-width: 640px) {
    .skills-section {
      padding: 64px 28px;
    }
    .skills-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 20px;
    }
  }

  @media (min-width: 1024px) {
    .skills-section {
      padding: 80px 32px;
    }
    .skills-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 24px;
    }
  }
</style>
