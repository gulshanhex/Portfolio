---
import TopNav from './ui/TopNav.astro';

interface Props {
  name: string;
  contact: Record<string, any>;
  nav: Record<string, any>;
  theme: Record<string, any>;
  sections: Array<{ id: string; label: string; order_idx: number; visible: number }>;
  hasProjects?: boolean;
  settings?: Record<string, any>;
}

const {
  name,
  contact = {},
  nav = {},
  theme = {},
  sections = [],
  hasProjects = true,
  settings = {},
} = Astro.props;
---

<TopNav
  name={name}
  contact={contact}
  nav={nav}
  theme={theme}
  sections={sections}
  hasProjects={hasProjects}
  settings={settings}
/>
