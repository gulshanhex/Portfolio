---
import { sanitizeBasicHtml } from '../lib/db';
import { t } from '../lib/ui-strings';

interface FooterLinkItem {
  label: string;
  url: string;
}

interface Props {
  globalCfg?: Record<string, any>;
  contact?: Record<string, any>;
  settings?: Record<string, any>;
}

const { globalCfg = {}, contact = {}, settings = {} } = Astro.props;
const name = globalCfg.name || 'Your Name';
const tagline = globalCfg.tagline || 'Automation & AI Systems Engineer';
const footerHtml = sanitizeBasicHtml(
  globalCfg.footer_text || `Built by <strong>${name}</strong>`
);

const mainSiteUrl = contact.main_site || globalCfg.domain || '';
const portfolioHost = (contact.portfolio || globalCfg.portfolio || '').replace(/^https?:\/\//, '').replace(/\/$/, '');

const customFooterLinks: FooterLinkItem[] = Array.isArray(globalCfg.footer_links) && globalCfg.footer_links.length > 0
  ? globalCfg.footer_links
  : [
      { label: 'Work Archive', url: '/work' },
      { label: 'LLMs.txt', url: '/llms.txt' },
      { label: 'Sitemap', url: '/sitemap.xml' },
    ];

const brandMark = t(settings, 'a11y.brand_mark');
const brandHomeAria = `${name} ${t(settings, 'a11y.brand_home_aria')}`;
const footerLinksAria = t(settings, 'footer.links_aria');
const mainSiteLabel = t(settings, 'footer.main_site_label');
const githubLabel = t(settings, 'footer.github_label');
const linkedinLabel = t(settings, 'footer.linkedin_label');
const subcopyText = t(settings, 'footer.subcopy');
const installAppLabel = t(settings, 'nav.install_app_label');
const installAria = t(settings, 'nav.install_aria');
---

<footer id="gk-footer" class="site-footer" role="contentinfo">
  <div class="footer-container">
    <div class="footer-top">
      <div class="footer-brand">
        <a href="#hero" class="footer-logo" aria-label={brandHomeAria}>
          <span>{brandMark}</span><span class="footer-dot">.</span>
        </a>
        <p class="footer-tagline">{tagline}</p>
      </div>

      <nav class="footer-nav" aria-label={footerLinksAria}>
        {mainSiteUrl && (
          <a href={mainSiteUrl} target="_blank" rel="noopener noreferrer" class="footer-link">
            {mainSiteLabel} ↗
          </a>
        )}
        {contact.github && (
          <a href={contact.github} target="_blank" rel="noopener noreferrer" class="footer-link">
            {githubLabel} ↗
          </a>
        )}
        {contact.linkedin && (
          <a href={contact.linkedin} target="_blank" rel="noopener noreferrer" class="footer-link">
            {linkedinLabel} ↗
          </a>
        )}
        {customFooterLinks.map((lnk) => {
          const isExternal = lnk.url.startsWith('http://') || lnk.url.startsWith('https://');
          return (
            <a
              href={lnk.url}
              target={isExternal ? '_blank' : undefined}
              rel={isExternal ? 'noopener noreferrer' : undefined}
              class="footer-link"
            >
              {lnk.label}{isExternal ? ' ↗' : ''}
            </a>
          );
        })}
        <button
          type="button"
          id="pwa-footer-install"
          class="footer-link footer-install-btn"
          aria-label={installAria}
          style="display:none;"
        >
          <span>{installAppLabel} ↓</span>
        </button>
      </nav>
    </div>

    <div class="footer-bottom">
      <div class="footer-copy" set:html={footerHtml} />
      <div class="footer-subcopy">
        {portfolioHost ? `${portfolioHost} · ${subcopyText}` : subcopyText}
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    background: var(--surface);
    padding: 40px 20px calc(40px + var(--bottom-bar-height) + env(safe-area-inset-bottom, 0px));
  }

  .footer-container {
    max-width: var(--max-w-content);
    margin: 0 auto;
  }

  .footer-top {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--border-subtle);
    margin-bottom: 20px;
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .footer-logo {
    display: inline-flex;
    align-items: center;
    font-family: var(--ff-sans);
    font-size: 1.35rem;
    font-weight: 800;
    color: var(--heading);
    text-decoration: none;
    letter-spacing: -0.03em;
  }

  .footer-dot {
    color: var(--accent);
  }

  .footer-tagline {
    font-family: var(--ff-sans);
    font-size: var(--fs-xs);
    color: var(--muted);
  }

  .footer-nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 24px;
  }

  .footer-link {
    font-family: var(--ff-sans);
    font-size: var(--fs-xs);
    font-weight: 500;
    color: var(--muted);
    background: transparent;
    border: none;
    padding: 0;
    cursor: pointer;
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .footer-link:hover {
    color: var(--accent);
  }

  .footer-install-btn {
    color: var(--accent);
    font-weight: 600;
  }

  .footer-bottom {
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-family: var(--ff-sans);
    font-size: var(--fs-xs);
    color: var(--muted);
  }

  .footer-copy :global(strong) {
    color: var(--text);
  }

  .footer-subcopy {
    opacity: 0.75;
    font-size: 0.72rem;
    font-family: var(--ff-mono);
  }

  @media (min-width: 768px) {
    .site-footer {
      padding: 48px 28px;
    }
    .footer-top {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
    .footer-bottom {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  @media (min-width: 1024px) {
    .site-footer {
      padding: 56px 32px;
    }
  }

  @media (display-mode: standalone) {
    .footer-install-btn {
      display: none !important;
    }
  }
</style>
