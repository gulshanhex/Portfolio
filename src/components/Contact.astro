---
import SectionHeader from './ui/SectionHeader.astro';
import Button from './ui/Button.astro';
import Card from './ui/Card.astro';
import Icon from './ui/Icon.astro';
import { sanitizeBasicHtml } from '../lib/db';
import { t } from '../lib/ui-strings';

interface Props {
  contact?: Record<string, any>;
  nav?: Record<string, any>;
  copy?: Record<string, any>;
  sectionNum?: string;
  settings?: Record<string, any>;
}

const { contact = {}, nav = {}, copy = {}, settings = {} } = Astro.props;
const formEnabled = contact.form_enabled !== false;

const eyebrow = copy.contact_eyebrow || t(settings, 'contact.eyebrow_default');
const title = copy.contact_title || t(settings, 'contact.title_default');
const subtitle = copy.contact_subtitle || t(settings, 'contact.subtitle_default');
const introText = contact.intro_text || t(settings, 'contact.intro_default');

const emailLabel = t(settings, 'contact.channel_email_label');
const linkedinLabel = t(settings, 'contact.channel_linkedin_label');
const githubLabel = t(settings, 'contact.channel_github_label');
const websiteLabel = t(settings, 'contact.channel_website_label');
const resumeLabel = t(settings, 'contact.channel_resume_label');
const resumeVal = nav.resume_label || t(settings, 'contact.channel_resume_default');

const formAria = t(settings, 'contact.form_aria');
const honeypotLabel = t(settings, 'contact.honeypot_label');
const nameLabel = t(settings, 'contact.field_name_label');
const namePlaceholder = t(settings, 'contact.field_name_placeholder');
const fieldEmailLabel = t(settings, 'contact.field_email_label');
const fieldEmailPlaceholder = t(settings, 'contact.field_email_placeholder');
const subjectLabel = t(settings, 'contact.field_subject_label');
const subjectPlaceholder = t(settings, 'contact.field_subject_placeholder');
const messageLabel = t(settings, 'contact.field_message_label');
const messagePlaceholder = t(settings, 'contact.field_message_placeholder');
const submitBtnText = t(settings, 'contact.submit_btn');
const sendingBtnText = t(settings, 'contact.sending_btn');
const msgRequiredErr = t(settings, 'contact.msg_required_err');
const msgSuccess = t(settings, 'contact.msg_success');
const msgError = t(settings, 'contact.msg_error');
const msgNetworkErr = t(settings, 'contact.msg_network_err');
const formDisabledText = t(settings, 'contact.form_disabled_text');
---

<section id="contact" class="contact-section" aria-labelledby="contact-title">
  <div class="contact-container">
    <SectionHeader eyebrow={eyebrow} title={title} subtitle={subtitle} />

    <div class="contact-grid">
      <!-- Contact Direct Channels Column -->
      <div class="contact-channels rv">
        <p class="channels-intro" set:html={sanitizeBasicHtml(introText)} />

        <div class="channels-list">
          {contact.email && (
            <Card as="a" href={`mailto:${contact.email}`} class="channel-card" interactive={true}>
              <div class="channel-card-inner">
                <div class="channel-icon" aria-hidden="true">
                  <Icon name="mail" size={20} />
                </div>
                <div class="channel-text">
                  <span class="channel-label">{emailLabel}</span>
                  <span class="channel-val">{contact.email}</span>
                </div>
                <span class="channel-arrow" aria-hidden="true">→</span>
              </div>
            </Card>
          )}

          {contact.linkedin && (
            <Card as="a" href={contact.linkedin} target="_blank" rel="noopener noreferrer" class="channel-card" interactive={true}>
              <div class="channel-card-inner">
                <div class="channel-icon" aria-hidden="true">
                  <Icon name="work" size={20} />
                </div>
                <div class="channel-text">
                  <span class="channel-label">{linkedinLabel}</span>
                  <span class="channel-val">{contact.linkedin.replace(/^https?:\/\/(www\.)?linkedin\.com\/in\//, '/in/')}</span>
                </div>
                <span class="channel-arrow" aria-hidden="true">↗</span>
              </div>
            </Card>
          )}

          {contact.github && (
            <Card as="a" href={contact.github} target="_blank" rel="noopener noreferrer" class="channel-card" interactive={true}>
              <div class="channel-card-inner">
                <div class="channel-icon" aria-hidden="true">
                  <Icon name="code" size={20} />
                </div>
                <div class="channel-text">
                  <span class="channel-label">{githubLabel}</span>
                  <span class="channel-val">{contact.github.replace(/^https?:\/\/(www\.)?github\.com\//, 'github.com/')}</span>
                </div>
                <span class="channel-arrow" aria-hidden="true">↗</span>
              </div>
            </Card>
          )}

          {contact.main_site && (
            <Card as="a" href={contact.main_site} target="_blank" rel="noopener noreferrer" class="channel-card" interactive={true}>
              <div class="channel-card-inner">
                <div class="channel-icon" aria-hidden="true">
                  <Icon name="hub" size={20} />
                </div>
                <div class="channel-text">
                  <span class="channel-label">{websiteLabel}</span>
                  <span class="channel-val">{contact.main_site.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '')}</span>
                </div>
                <span class="channel-arrow" aria-hidden="true">↗</span>
              </div>
            </Card>
          )}

          {contact.resume_url && (
            <Card as="a" href={contact.resume_url} target="_blank" rel="noopener noreferrer" class="channel-card" interactive={true}>
              <div class="channel-card-inner">
                <div class="channel-icon" aria-hidden="true">
                  <Icon name="school" size={20} />
                </div>
                <div class="channel-text">
                  <span class="channel-label">{resumeLabel}</span>
                  <span class="channel-val">{resumeVal}</span>
                </div>
                <span class="channel-arrow" aria-hidden="true">↗</span>
              </div>
            </Card>
          )}
        </div>
      </div>

      <!-- Contact Message Form Column -->
      <div class="contact-form-wrap rv" style="transition-delay: 0.12s">
        {formEnabled ? (
          <Card class="form-card">
            <form
              id="ct-form"
              class="ct-form"
              novalidate
              aria-label={formAria}
              data-msg-required={msgRequiredErr}
              data-msg-success={msgSuccess}
              data-msg-error={msgError}
              data-msg-network={msgNetworkErr}
              data-btn-send={submitBtnText}
              data-btn-sending={sendingBtnText}
            >
              <!-- Honeypot field (hidden from humans, catches bots) -->
              <div class="hp-field" style="position:absolute;left:-9999px;opacity:0;pointer-events:none;height:0;overflow:hidden" aria-hidden="true">
                <label for="ct-hp">{honeypotLabel}</label>
                <input type="text" id="ct-hp" name="_hp" tabindex="-1" autocomplete="off" />
              </div>

              <div class="form-row">
                <div class="form-field">
                  <label for="ct-name" class="field-label">{nameLabel} <span class="req">*</span></label>
                  <input
                    type="text"
                    id="ct-name"
                    name="name"
                    placeholder={namePlaceholder}
                    required
                    autocomplete="name"
                    maxlength="100"
                    class="field-input"
                  />
                </div>
                <div class="form-field">
                  <label for="ct-email" class="field-label">{fieldEmailLabel} <span class="req">*</span></label>
                  <input
                    type="email"
                    id="ct-email"
                    name="email"
                    placeholder={fieldEmailPlaceholder}
                    required
                    autocomplete="email"
                    maxlength="200"
                    class="field-input"
                  />
                </div>
              </div>

              <div class="form-field">
                <label for="ct-subject" class="field-label">{subjectLabel}</label>
                <input
                  type="text"
                  id="ct-subject"
                  name="subject"
                  placeholder={subjectPlaceholder}
                  maxlength="200"
                  class="field-input"
                />
              </div>

              <div class="form-field">
                <label for="ct-message" class="field-label">{messageLabel} <span class="req">*</span></label>
                <textarea
                  id="ct-message"
                  name="message"
                  placeholder={messagePlaceholder}
                  required
                  rows="4"
                  maxlength="5000"
                  class="field-textarea"
                />
              </div>

              <div id="ct-msg" role="status" aria-live="polite" class="form-feedback" style="display:none"></div>

              <Button type="submit" variant="primary" size="lg" class="submit-btn">
                <span id="ct-btn-txt">{submitBtnText}</span>
                <span aria-hidden="true">→</span>
              </Button>
            </form>
          </Card>
        ) : (
          <Card class="form-disabled-card">
            <p>{formDisabledText} <a href={`mailto:${contact.email}`}>{contact.email}</a>.</p>
          </Card>
        )}
      </div>
    </div>
  </div>
</section>

<style>
  .contact-section {
    padding: 48px 20px;
    background: var(--bg);
  }

  .contact-container {
    max-width: var(--max-w-content);
    margin: 0 auto;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 28px;
    align-items: start;
  }

  .channels-intro {
    font-family: var(--ff-sans);
    font-size: var(--fs-base);
    color: var(--muted);
    line-height: 1.6;
    margin-bottom: var(--sp-4);
  }

  .channels-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  :global(.channel-card) {
    padding: 14px 18px !important;
    text-decoration: none;
  }

  .channel-card-inner {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .channel-icon {
    width: 40px;
    height: 40px;
    border-radius: var(--radius-btn);
    background: var(--accent-subtle);
    border: 1px solid var(--accent-border);
    color: var(--accent);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .channel-text {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .channel-label {
    font-family: var(--ff-mono);
    font-size: 0.7rem;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .channel-val {
    font-family: var(--ff-sans);
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--heading);
    overflow-wrap: anywhere;
  }

  .channel-arrow {
    color: var(--muted);
    flex-shrink: 0;
    transition: color var(--transition-fast), transform var(--transition-fast);
  }

  :global(.channel-card:hover) .channel-arrow {
    color: var(--accent);
    transform: translateX(3px);
  }

  /* Form */
  :global(.form-card) {
    padding: 20px !important;
    background: var(--surface) !important;
  }

  .ct-form {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }

  .form-field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .field-label {
    font-family: var(--ff-sans);
    font-size: var(--fs-xs);
    font-weight: 600;
    color: var(--text);
  }

  .req {
    color: var(--accent);
  }

  .field-input,
  .field-textarea {
    width: 100%;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-btn);
    padding: 11px 14px;
    color: var(--text);
    font-family: var(--ff-sans);
    font-size: var(--fs-sm);
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .field-input:focus,
  .field-textarea:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 2px var(--accent-subtle);
  }

  .field-textarea {
    resize: vertical;
    min-height: 115px;
  }

  .form-feedback {
    padding: 10px 14px;
    border-radius: var(--radius-sm);
    font-family: var(--ff-sans);
    font-size: var(--fs-xs);
    font-weight: 500;
  }

  :global(.form-msg.ok) {
    background: var(--accent-subtle);
    border: 1px solid var(--accent-border);
    color: var(--accent);
  }

  :global(.form-msg.err) {
    background: rgba(217, 83, 79, 0.12);
    border: 1px solid rgba(217, 83, 79, 0.3);
    color: #D9534F;
  }

  :global(.submit-btn) {
    width: 100% !important;
    justify-content: center !important;
    margin-top: var(--sp-1);
  }

  @media (min-width: 640px) {
    .contact-section {
      padding: 64px 28px;
    }
    .form-row {
      grid-template-columns: 1fr 1fr;
    }
    :global(.form-card) {
      padding: 24px !important;
    }
  }

  @media (min-width: 768px) {
    .contact-grid {
      grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
      gap: 32px;
    }
  }

  @media (min-width: 1024px) {
    .contact-section {
      padding: 80px 32px;
    }
    .contact-grid {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      gap: 48px;
    }
  }
</style>
