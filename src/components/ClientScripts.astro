---
import { t } from '../lib/ui-strings';

interface Props {
  userToggleEnabled?: boolean;
  settings?: Record<string, any>;
}

const { userToggleEnabled = true, settings = {} } = Astro.props;

const pwaCopy = {
  updateAvailable: t(settings, 'pwa.update_available'),
  refreshBtn: t(settings, 'pwa.refresh_btn'),
  installTitle: t(settings, 'pwa.install_title'),
  installDesc: t(settings, 'pwa.install_desc'),
  installBtn: t(settings, 'pwa.install_btn'),
  dismissAria: t(settings, 'pwa.dismiss_aria'),
  iosTitle: t(settings, 'pwa.ios_title'),
  iosDesc: t(settings, 'pwa.ios_desc'),
};

const offlineCopy = {
  eyebrow: t(settings, 'offline.eyebrow'),
  title: t(settings, 'offline.title'),
  description: t(settings, 'offline.description'),
  retryBtn: t(settings, 'offline.retry_btn'),
  homeBtn: t(settings, 'offline.home_btn'),
};
---

<script is:inline define:vars={{ userToggleEnabled, pwaCopy, offlineCopy }}>
  (function () {
    const root = document.documentElement;

    // Persist admin-editable offline strings for public/offline.html
    try {
      localStorage.setItem('gk-offline-copy', JSON.stringify(offlineCopy));
    } catch (e) {}

    // ── Theme Toggle ───────────────────────────────────
    const themeIcon = document.getElementById('theme-icon');
    function syncThemeIcon() {
      const current = root.getAttribute('data-theme') || 'dark';
      if (themeIcon) {
        themeIcon.textContent = current === 'dark' ? 'light_mode' : 'dark_mode';
      }
    }
    syncThemeIcon();

    if (userToggleEnabled) {
      document.querySelectorAll('#theme-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const current = root.getAttribute('data-theme') || 'dark';
          const next = current === 'dark' ? 'light' : 'dark';
          root.setAttribute('data-theme', next);
          try {
            localStorage.setItem('gk-theme', next);
          } catch (e) {}
          syncThemeIcon();
        });
      });
    }

    // ── Progressive Reveal on Scroll (IntersectionObserver) ──
    if (
      'IntersectionObserver' in window &&
      window.matchMedia('(prefers-reduced-motion: no-preference)').matches
    ) {
      const revealObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('vis');
              revealObserver.unobserve(e.target);
            }
          });
        },
        { threshold: 0.08, rootMargin: '0px 0px -40px 0px' }
      );
      document.querySelectorAll('.rv').forEach((el) => revealObserver.observe(el));
    } else {
      document.querySelectorAll('.rv').forEach((el) => el.classList.add('vis'));
    }

    // ── Scroll Spy for Active Navigation Links ─────────
    if ('IntersectionObserver' in window) {
      const navLinks = document.querySelectorAll('.nav-link, .tab-item[data-tab]');
      const sections = document.querySelectorAll('section[id]');

      const spyObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const id = entry.target.getAttribute('id');
              navLinks.forEach((link) => {
                const isMatch =
                  link.getAttribute('data-section') === id ||
                  link.getAttribute('data-tab') === id ||
                  link.getAttribute('href') === '#' + id;
                if (isMatch) {
                  link.classList.add('active');
                } else if (link.getAttribute('data-tab') !== 'contact') {
                  link.classList.remove('active');
                }
              });
            }
          });
        },
        { threshold: 0.25, rootMargin: '-64px 0px -40% 0px' }
      );

      sections.forEach((sec) => spyObserver.observe(sec));
    }

    // ── Desktop Top Nav "More" Dropdown ────────────────
    const topMoreBtn = document.getElementById('top-more-btn');
    const topMoreMenu = document.getElementById('top-more-menu');
    if (topMoreBtn && topMoreMenu) {
      topMoreBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        const isOpen = !topMoreMenu.hidden;
        topMoreMenu.hidden = isOpen;
        topMoreBtn.setAttribute('aria-expanded', String(!isOpen));
      });

      document.addEventListener('click', (e) => {
        if (!topMoreMenu.contains(e.target) && e.target !== topMoreBtn) {
          topMoreMenu.hidden = true;
          topMoreBtn.setAttribute('aria-expanded', 'false');
        }
      });
    }

    // ── Mobile Bottom Sheet Drawer ─────────────────────
    const bottomMoreBtn = document.getElementById('bottom-more-btn');
    const bottomSheetModal = document.getElementById('bottom-sheet-modal');
    const sheetCloseBtn = document.getElementById('sheet-close-btn');

    function openBottomSheet() {
      if (bottomSheetModal) {
        bottomSheetModal.hidden = false;
        bottomMoreBtn?.setAttribute('aria-expanded', 'true');
        document.body.style.overflow = 'hidden';
      }
    }

    function closeBottomSheet() {
      if (bottomSheetModal) {
        bottomSheetModal.hidden = true;
        bottomMoreBtn?.setAttribute('aria-expanded', 'false');
        document.body.style.overflow = '';
      }
    }

    bottomMoreBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      openBottomSheet();
    });

    sheetCloseBtn?.addEventListener('click', closeBottomSheet);

    bottomSheetModal?.addEventListener('click', (e) => {
      if (e.target === bottomSheetModal) {
        closeBottomSheet();
      }
    });

    bottomSheetModal?.querySelectorAll('a').forEach((a) => {
      a.addEventListener('click', closeBottomSheet);
    });

    // Escape Key Listener
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        if (topMoreMenu && !topMoreMenu.hidden) {
          topMoreMenu.hidden = true;
          topMoreBtn?.setAttribute('aria-expanded', 'false');
        }
        if (bottomSheetModal && !bottomSheetModal.hidden) {
          closeBottomSheet();
        }
      }
    });

    // ── Project Category Filter (Hides grid wrapper .rv so no empty grid cells remain) ──
    document.querySelectorAll('.proj-filter-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.proj-filter-btn').forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        const cat = (btn.getAttribute('data-cat') || 'all').toLowerCase();
        document.querySelectorAll('.project-card').forEach((card) => {
          const cardCat = (card.getAttribute('data-cat') || '').toLowerCase();
          const match = cat === 'all' || cardCat === cat;
          const wrapper = card.closest('.rv') || card;
          wrapper.style.display = match ? '' : 'none';
        });
      });
    });

    // ── Contact Form Submission (Honeypot + Elapsed Delta) ──
    const ctForm = document.getElementById('ct-form');
    const ctMsg = document.getElementById('ct-msg');
    const ctBtnTxt = document.getElementById('ct-btn-txt');
    const formInitTime = performance.now();

    if (ctForm && ctMsg) {
      const msgReq = ctForm.getAttribute('data-msg-required') || '';
      const msgOk = ctForm.getAttribute('data-msg-success') || '';
      const msgErr = ctForm.getAttribute('data-msg-error') || '';
      const msgNet = ctForm.getAttribute('data-msg-network') || '';
      const btnSendTxt = ctForm.getAttribute('data-btn-send') || '';
      const btnSendingTxt = ctForm.getAttribute('data-btn-sending') || '';

      ctForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const fd = new FormData(ctForm);
        const elapsedMs = Math.round(performance.now() - formInitTime);
        const body = {
          name: String(fd.get('name') || '').trim(),
          email: String(fd.get('email') || '').trim(),
          subject: String(fd.get('subject') || '').trim() || undefined,
          message: String(fd.get('message') || '').trim(),
          _hp: String(fd.get('_hp') || '').trim(),
          _elapsed: elapsedMs,
        };

        if (!body.name || !body.email || !body.message) {
          ctMsg.className = 'form-msg err';
          ctMsg.textContent = msgReq;
          ctMsg.style.display = 'block';
          return;
        }

        const btn = ctForm.querySelector('button[type="submit"]');
        if (ctBtnTxt && btnSendingTxt) ctBtnTxt.textContent = btnSendingTxt;
        if (btn) btn.disabled = true;

        try {
          const res = await fetch('/api/contact', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(body),
          });
          const data = await res.json();
          if (res.ok) {
            ctMsg.className = 'form-msg ok';
            ctMsg.textContent = data.message || msgOk;
            ctMsg.style.display = 'block';
            ctForm.reset();
          } else {
            ctMsg.className = 'form-msg err';
            ctMsg.textContent = data.error || msgErr;
            ctMsg.style.display = 'block';
          }
        } catch {
          ctMsg.className = 'form-msg err';
          ctMsg.textContent = msgNet;
          ctMsg.style.display = 'block';
        }

        if (ctBtnTxt && btnSendTxt) ctBtnTxt.textContent = btnSendTxt;
        if (btn) btn.disabled = false;
      });
    }

    // PWA Service Worker & Install Flow
    if ('serviceWorker' in navigator && (window.location.protocol === 'https:' || window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1')) {
      let refreshing = false;
      navigator.serviceWorker.addEventListener('controllerchange', () => {
        if (!refreshing) {
          refreshing = true;
          window.location.reload();
        }
      });

      window.addEventListener('load', async () => {
        try {
          const reg = await navigator.serviceWorker.register('/sw.js');

          if (reg.waiting && navigator.serviceWorker.controller) {
            showUpdateToast(reg.waiting);
          }

          reg.addEventListener('updatefound', () => {
            const newWorker = reg.installing;
            if (newWorker) {
              newWorker.addEventListener('statechange', () => {
                if (newWorker.state === 'installed' && navigator.serviceWorker.controller) {
                  showUpdateToast(newWorker);
                }
              });
            }
          });
        } catch (e) {
          // SW registration failed silently
        }
      });

      function showUpdateToast(worker) {
        if (document.getElementById('pwa-update-toast')) return;
        const toast = document.createElement('div');
        toast.id = 'pwa-update-toast';
        toast.className = 'pwa-toast';
        toast.innerHTML = `
          <div class="pwa-toast-inner">
            <span>${pwaCopy.updateAvailable}</span>
            <button type="button" id="pwa-refresh-btn" class="pwa-toast-btn">${pwaCopy.refreshBtn}</button>
          </div>
        `;
        document.body.appendChild(toast);
        document.getElementById('pwa-refresh-btn')?.addEventListener('click', () => {
          worker.postMessage({ type: 'SKIP_WAITING' });
        });
      }

      let deferredPrompt = null;
      const installButtons = [
        document.getElementById('pwa-desktop-install'),
        document.getElementById('pwa-sheet-install'),
        document.getElementById('pwa-footer-install'),
      ].filter(Boolean);

      async function handleInstallClick() {
        if (!deferredPrompt) return;
        deferredPrompt.prompt();
        await deferredPrompt.userChoice;
        deferredPrompt = null;
        installButtons.forEach((b) => {
          if (b) b.style.display = 'none';
        });
        document.getElementById('pwa-install-banner')?.remove();
        closeBottomSheet();
      }

      installButtons.forEach((b) => {
        b?.addEventListener('click', handleInstallClick);
      });

      window.addEventListener('beforeinstallprompt', (e) => {
        e.preventDefault();
        deferredPrompt = e;

        installButtons.forEach((b) => {
          if (b) b.style.display = b.id === 'pwa-sheet-install' ? 'flex' : 'inline-flex';
        });

        const isDismissed = localStorage.getItem('pwa_install_dismissed') === 'true';
        if (!isDismissed) {
          const triggerBanner = () => {
            if (document.getElementById('pwa-install-banner') || !deferredPrompt) return;
            const banner = document.createElement('div');
            banner.id = 'pwa-install-banner';
            banner.className = 'pwa-banner';
            banner.innerHTML = `
              <div class="pwa-banner-inner">
                <div class="pwa-banner-text">
                  <strong>${pwaCopy.installTitle}</strong>
                  <p>${pwaCopy.installDesc}</p>
                </div>
                <div class="pwa-banner-actions">
                  <button type="button" id="pwa-install-action" class="pwa-action-btn">${pwaCopy.installBtn}</button>
                  <button type="button" id="pwa-dismiss-action" class="pwa-dismiss-btn" aria-label="${pwaCopy.dismissAria}">&times;</button>
                </div>
              </div>
            `;
            document.body.appendChild(banner);

            document.getElementById('pwa-install-action')?.addEventListener('click', handleInstallClick);

            document.getElementById('pwa-dismiss-action')?.addEventListener('click', () => {
              banner.remove();
              localStorage.setItem('pwa_install_dismissed', 'true');
            });
          };

          setTimeout(triggerBanner, 4000);
          window.addEventListener('scroll', () => {
            if (window.scrollY > 300) triggerBanner();
          }, { once: true });
        }
      });

      const isIOS = /iPad|iPhone|iPod/.test(navigator.userAgent) && !window.MSStream;
      const isStandalone = window.matchMedia('(display-mode: standalone)').matches || ('standalone' in navigator && navigator.standalone);
      const isIosDismissed = localStorage.getItem('pwa_ios_hint_dismissed') === 'true';

      if (isIOS && !isStandalone && !isIosDismissed) {
        setTimeout(() => {
          if (document.getElementById('pwa-ios-hint')) return;
          const hint = document.createElement('div');
          hint.id = 'pwa-ios-hint';
          hint.className = 'pwa-banner';
          hint.innerHTML = `
            <div class="pwa-banner-inner">
              <div class="pwa-banner-text">
                <strong>${pwaCopy.iosTitle}</strong>
                <p>${pwaCopy.iosDesc}</p>
              </div>
              <button type="button" id="pwa-ios-dismiss" class="pwa-dismiss-btn" aria-label="${pwaCopy.dismissAria}">&times;</button>
            </div>
          `;
          document.body.appendChild(hint);
          document.getElementById('pwa-ios-dismiss')?.addEventListener('click', () => {
            hint.remove();
            localStorage.setItem('pwa_ios_hint_dismissed', 'true');
          });
        }, 5000);
      }
    }
  })();
</script>

<style is:global>
  .pwa-toast {
    position: fixed;
    bottom: calc(var(--bottom-bar-height) + 16px);
    right: 16px;
    left: 16px;
    max-width: 360px;
    margin-left: auto;
    z-index: 10000;
    background: var(--card);
    border: 1px solid var(--accent);
    border-radius: var(--radius-btn);
    box-shadow: var(--shadow-lg);
    padding: 12px 18px;
    font-family: var(--ff-sans);
    font-size: var(--fs-sm);
    color: var(--text);
  }
  .pwa-toast-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .pwa-toast-btn {
    background: var(--accent);
    color: var(--text-on-accent);
    border: none;
    border-radius: var(--radius-sm);
    padding: 6px 12px;
    font-weight: 700;
    font-size: 0.8rem;
    cursor: pointer;
  }
  .pwa-banner {
    position: fixed;
    bottom: calc(var(--bottom-bar-height) + 14px);
    left: 50%;
    transform: translateX(-50%);
    width: calc(100% - 32px);
    max-width: 440px;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-lg);
    padding: 14px 18px;
    z-index: 9999;
    font-family: var(--ff-sans);
  }
  @media (min-width: 768px) {
    .pwa-toast {
      bottom: 24px;
      right: 24px;
      left: auto;
    }
    .pwa-banner {
      bottom: 20px;
    }
  }
  .pwa-banner-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .pwa-banner-text strong {
    display: block;
    color: var(--heading);
    font-size: 0.9rem;
    margin-bottom: 2px;
  }
  .pwa-banner-text p {
    margin: 0;
    color: var(--muted);
    font-size: 0.78rem;
    line-height: 1.35;
  }
  .pwa-banner-actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .pwa-action-btn {
    background: var(--accent);
    color: var(--text-on-accent);
    border: none;
    border-radius: var(--radius-btn);
    padding: 7px 14px;
    font-weight: 700;
    font-size: 0.8rem;
    cursor: pointer;
  }
  .pwa-dismiss-btn {
    background: transparent;
    border: none;
    color: var(--muted);
    font-size: 1.25rem;
    line-height: 1;
    padding: 4px;
    cursor: pointer;
  }
  .pwa-dismiss-btn:hover {
    color: var(--text);
  }
  @media (display-mode: standalone) {
    #pwa-install-banner,
    #pwa-desktop-install,
    #pwa-sheet-install,
    #pwa-footer-install,
    #pwa-ios-hint {
      display: none !important;
    }
  }
</style>
