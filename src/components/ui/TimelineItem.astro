---
import Icon from './Icon.astro';
import { sanitizeBasicHtml } from '../../lib/db';

interface Props {
  icon?: string;
  title: string;
  organization: string;
  dateRange: string;
  duration?: string;
  location?: string;
  badgeLabel?: string;
  bulletPoints?: string[];
  tags?: string[];
  class?: string;
}

const {
  icon = 'work',
  title,
  organization,
  dateRange,
  duration,
  location,
  badgeLabel,
  bulletPoints = [],
  tags = [],
  class: className = '',
} = Astro.props;
---

<div class={`timeline-item ${className}`}>
  <div class="timeline-indicator" aria-hidden="true">
    <div class="timeline-icon">
      <Icon name={icon} size={18} />
    </div>
    <div class="timeline-line"></div>
  </div>

  <div class="timeline-content">
    <div class="timeline-header">
      <div class="timeline-meta-top">
        <span class="timeline-dates">{dateRange}</span>
        {duration && <span class="timeline-duration">· {duration}</span>}
        {badgeLabel && <span class="timeline-badge">{badgeLabel}</span>}
      </div>
      <h3 class="timeline-title">{title}</h3>
      <div class="timeline-org">
        <span class="org-name">{organization}</span>
        {location && <span class="org-location">· {location}</span>}
      </div>
    </div>

    {bulletPoints.length > 0 && (
      <ul class="timeline-bullets">
        {bulletPoints.map((pt) => (
          <li set:html={sanitizeBasicHtml(pt)} />
        ))}
      </ul>
    )}

    {tags.length > 0 && (
      <div class="timeline-tags">
        {tags.map((t) => (
          <span class="timeline-tag">{t}</span>
        ))}
      </div>
    )}
  </div>
</div>

<style>
  .timeline-item {
    display: flex;
    gap: 14px;
    position: relative;
    padding-bottom: 20px;
  }

  .timeline-item:last-child {
    padding-bottom: 0;
  }

  .timeline-indicator {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex-shrink: 0;
  }

  .timeline-icon {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--accent);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
  }

  .timeline-line {
    width: 2px;
    flex-grow: 1;
    background: var(--border);
    margin-top: 8px;
  }

  .timeline-item:last-child .timeline-line {
    display: none;
  }

  .timeline-content {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    padding: 18px 20px;
    flex-grow: 1;
    min-width: 0;
    box-shadow: var(--shadow-card);
  }

  @media (min-width: 640px) {
    .timeline-item {
      gap: var(--sp-4);
      padding-bottom: var(--sp-5);
    }
    .timeline-content {
      padding: var(--sp-5);
    }
  }

  .timeline-header {
    margin-bottom: var(--sp-3);
  }

  .timeline-meta-top {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px;
    font-family: var(--ff-mono);
    font-size: var(--fs-xs);
    color: var(--muted);
    margin-bottom: 4px;
  }

  .timeline-badge {
    padding: 2px 8px;
    border-radius: var(--radius-pill);
    background: var(--accent-subtle);
    border: 1px solid var(--accent-border);
    color: var(--accent);
    font-size: 0.7rem;
    font-weight: 600;
  }

  .timeline-title {
    font-family: var(--ff-sans);
    font-size: var(--fs-md);
    font-weight: 700;
    color: var(--heading);
    line-height: 1.3;
    margin-bottom: 2px;
  }

  .timeline-org {
    font-family: var(--ff-sans);
    font-size: var(--fs-sm);
    color: var(--muted);
  }

  .org-name {
    font-weight: 600;
    color: var(--text);
  }

  .timeline-bullets {
    margin: var(--sp-3) 0 var(--sp-4) 0;
    padding-left: 18px;
    list-style: disc;
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-family: var(--ff-sans);
    font-size: var(--fs-sm);
    color: var(--muted);
    line-height: 1.6;
  }

  .timeline-bullets :global(strong) {
    color: var(--heading);
    font-weight: 600;
  }

  .timeline-bullets :global(em) {
    color: var(--accent);
    font-style: normal;
  }

  .timeline-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: var(--sp-3);
  }

  .timeline-tag {
    font-family: var(--ff-mono);
    font-size: 0.72rem;
    padding: 3px 8px;
    border-radius: var(--radius-sm);
    background: var(--surface);
    color: var(--text-muted);
    border: 1px solid var(--border);
  }
</style>
