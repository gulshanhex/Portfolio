---
import { t } from '../../lib/ui-strings';

interface Props {
  class?: string;
  settings?: Record<string, any>;
  variant?: 'chat+chart' | 'chart' | 'none';
}

const {
  class: className = '',
  settings = {},
  variant = 'chat+chart',
} = Astro.props;

const showChat = variant === 'chat+chart';
const showChart = variant === 'chat+chart' || variant === 'chart';

const ariaLabel = t(settings, 'hero_visual.aria_label');
const apiTitle = t(settings, 'hero_visual.api_title');
const apiBadge = t(settings, 'hero_visual.api_badge');
const stat1Label = t(settings, 'hero_visual.stat1_label');
const stat1Value = t(settings, 'hero_visual.stat1_value');
const stat2Label = t(settings, 'hero_visual.stat2_label');
const stat2Value = t(settings, 'hero_visual.stat2_value');
const stat3Label = t(settings, 'hero_visual.stat3_label');
const stat3Value = t(settings, 'hero_visual.stat3_value');
const connectorText = t(settings, 'hero_visual.connector_text');
const botName = t(settings, 'hero_visual.bot_name');
const botStatus = t(settings, 'hero_visual.bot_status');
const botSender = t(settings, 'hero_visual.bot_sender');
const botMsg1 = t(settings, 'hero_visual.bot_msg1');
const codeSnippet = t(settings, 'hero_visual.code_snippet');
const userMsg = t(settings, 'hero_visual.user_msg');
const botReply = t(settings, 'hero_visual.bot_reply');
const inputPlaceholder = t(settings, 'hero_visual.input_placeholder');
const sendBtn = t(settings, 'hero_visual.send_btn');
const caption = t(settings, 'hero_visual.caption');
---

{
  showChart && (
    <div class={`hero-visual-container ${className}`} aria-label={ariaLabel}>
      <!-- Subtle background radial glow -->
      <div class="hero-glow" aria-hidden="true"></div>

      <!-- Top Layer: Automation API Telemetry Card -->
      <div class="visual-card card-api" aria-hidden="true">
        <div class="api-header">
          <div class="api-title">
            <span class="api-dot"></span>
            <span>{apiTitle}</span>
          </div>
          <span class="api-badge">{apiBadge}</span>
        </div>

        <!-- Sparkline Chart -->
        <div class="api-chart">
          <svg viewBox="0 0 300 72" class="sparkline-svg" preserveAspectRatio="none">
            <defs>
              <linearGradient id="chartGrad" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="var(--accent)" stop-opacity="0.28" />
                <stop offset="100%" stop-color="var(--accent)" stop-opacity="0.0" />
              </linearGradient>
            </defs>
            <path
              d="M0,54 Q40,58 70,38 T140,34 T210,16 T280,28 L300,18 L300,72 L0,72 Z"
              fill="url(#chartGrad)"
            />
            <path
              d="M0,54 Q40,58 70,38 T140,34 T210,16 T280,28 L300,18"
              fill="none"
              stroke="var(--accent)"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </div>

        <!-- Dashboard Sub-metrics -->
        <div class="api-stats">
          <div class="api-stat">
            <span class="api-stat-k">{stat1Label}</span>
            <span class="api-stat-v">{stat1Value}</span>
          </div>
          <div class="api-stat">
            <span class="api-stat-k">{stat2Label}</span>
            <span class="api-stat-v">{stat2Value}</span>
          </div>
          <div class="api-stat">
            <span class="api-stat-k">{stat3Label}</span>
            <span class="api-stat-v">{stat3Value}</span>
          </div>
        </div>
      </div>

      {showChat && (
        <>
          <!-- Pipeline Connector Indicator -->
          <div class="pipeline-connector" aria-hidden="true">
            <span class="connector-line"></span>
            <span class="connector-pill">{connectorText}</span>
            <span class="connector-line"></span>
          </div>

          <!-- Bottom Layer: Telegram-style Bot Chat Card -->
          <div class="visual-card card-chat" aria-hidden="true">
            <div class="chat-header">
              <div class="chat-user">
                <div class="chat-avatar">
                  <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
                    <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 0 0-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.55-.37-.63-.2-1.12-.31-1.08-.66.02-.18.27-.36.75-.55 2.92-1.27 4.86-2.11 5.83-2.51 2.78-1.16 3.35-1.36 3.73-1.36.08 0 .27.02.39.12.1.08.13.19.14.27-.01.06.01.24 0 .38z"/>
                  </svg>
                </div>
                <div class="chat-info">
                  <span class="chat-name">{botName}</span>
                  <span class="chat-status">{botStatus}</span>
                </div>
              </div>
              <div class="chat-dots">
                <span></span><span></span><span></span>
              </div>
            </div>

            <div class="chat-body">
              <div class="chat-bubble bot-bubble">
                <span class="bubble-sender">{botSender}</span>
                <p>{botMsg1}</p>
              </div>

              <div class="chat-code">
                <code>{codeSnippet}</code>
              </div>

              <div class="chat-bubble user-bubble">
                <p>{userMsg}</p>
              </div>

              <div class="chat-bubble bot-bubble success-bubble">
                <span class="check-icon">✓</span>
                <span>{botReply}</span>
              </div>
            </div>

            <div class="chat-footer">
              <span class="chat-placeholder">{inputPlaceholder}</span>
              <div class="chat-actions">
                <span class="chat-action-btn">{sendBtn}</span>
              </div>
            </div>
          </div>
        </>
      )}

      <div class="visual-caption">
        <span class="caption-dot"></span>
        <span>{caption}</span>
      </div>
    </div>
  )
}

<style>
  .hero-visual-container {
    position: relative;
    width: 100%;
    max-width: 500px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
  }

  /* Dark mode hero glow */
  .hero-glow {
    position: absolute;
    top: 15%;
    right: 5%;
    width: 300px;
    height: 300px;
    background: radial-gradient(circle, var(--accent-glow, var(--accent-subtle)) 0%, transparent 70%);
    filter: blur(48px);
    pointer-events: none;
    z-index: 0;
    opacity: 0.7;
  }

  :global([data-theme="light"]) .hero-glow {
    opacity: 0.25;
    background: radial-gradient(circle, rgba(23, 128, 74, 0.12) 0%, transparent 70%);
  }

  .visual-card {
    position: relative;
    border-radius: var(--radius-card);
    border: 1px solid var(--border);
    background: var(--surface);
    box-shadow: var(--shadow-card);
    z-index: 1;
    overflow: hidden;
  }

  /* Card 1: API Dashboard */
  .card-api {
    padding: 16px 18px;
    width: 100%;
    background: var(--card);
    border-color: var(--border);
  }

  .api-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 10px;
  }

  .api-title {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--ff-mono);
    font-size: var(--fs-xs);
    font-weight: 600;
    color: var(--heading);
  }

  .api-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
  }

  .api-badge {
    font-family: var(--ff-mono);
    font-size: 0.7rem;
    padding: 2px 8px;
    border-radius: var(--radius-pill);
    background: var(--accent-subtle);
    color: var(--accent);
    border: 1px solid var(--accent-border);
  }

  .api-chart {
    width: 100%;
    height: 54px;
    margin-bottom: 10px;
  }

  .sparkline-svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .api-stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
    padding-top: 10px;
    border-top: 1px solid var(--border-subtle);
  }

  .api-stat {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .api-stat-k {
    font-family: var(--ff-sans);
    font-size: 0.68rem;
    color: var(--muted);
  }

  .api-stat-v {
    font-family: var(--ff-mono);
    font-size: 0.76rem;
    font-weight: 600;
    color: var(--heading);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Pipeline Connector between cards */
  .pipeline-connector {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 6px 16px;
    z-index: 1;
  }

  .connector-line {
    height: 1px;
    flex: 1;
    background: var(--border);
  }

  .connector-pill {
    font-family: var(--ff-mono);
    font-size: 0.66rem;
    color: var(--muted);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    padding: 2px 10px;
    letter-spacing: 0.02em;
  }

  /* Card 2: Telegram Chat Card */
  .card-chat {
    width: 100%;
    padding: 16px 18px;
    z-index: 2;
    background: var(--surface-raised);
    border-color: var(--border);
    box-shadow: var(--shadow-md);
  }

  :global([data-theme="light"]) .card-chat {
    background: #FFFFFF;
  }

  .chat-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--border-subtle);
    margin-bottom: 12px;
  }

  .chat-user {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .chat-avatar {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: #2AABEE;
    color: #FFFFFF;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .chat-info {
    display: flex;
    flex-direction: column;
  }

  .chat-name {
    font-family: var(--ff-sans);
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--heading);
    line-height: 1.2;
  }

  .chat-status {
    font-family: var(--ff-mono);
    font-size: 0.68rem;
    color: var(--accent);
  }

  .chat-dots {
    display: flex;
    gap: 3px;
  }

  .chat-dots span {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--muted);
    opacity: 0.6;
  }

  .chat-body {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 12px;
  }

  .chat-bubble {
    padding: 8px 12px;
    border-radius: 10px;
    font-size: 0.82rem;
    line-height: 1.4;
    max-width: 88%;
  }

  .bot-bubble {
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--text);
    align-self: flex-start;
  }

  .bubble-sender {
    display: block;
    font-family: var(--ff-mono);
    font-size: 0.68rem;
    font-weight: 600;
    color: var(--accent);
    margin-bottom: 2px;
  }

  .user-bubble {
    background: var(--accent);
    color: var(--text-on-accent);
    font-weight: 500;
    align-self: flex-end;
    border-bottom-right-radius: 2px;
  }

  .success-bubble {
    display: flex;
    align-items: center;
    gap: 6px;
    background: var(--accent-subtle);
    border-color: var(--accent-border);
    color: var(--accent);
    font-weight: 600;
  }

  .check-icon {
    font-weight: 700;
  }

  .chat-code {
    background: var(--bg);
    border: 1px solid var(--border-subtle);
    border-radius: 6px;
    padding: 6px 10px;
    font-family: var(--ff-mono);
    font-size: 0.72rem;
    color: var(--accent);
    align-self: flex-start;
    max-width: 100%;
    overflow-x: auto;
  }

  .chat-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8px 12px;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 8px;
  }

  .chat-placeholder {
    font-size: 0.78rem;
    color: var(--muted);
    opacity: 0.75;
  }

  .chat-action-btn {
    font-family: var(--ff-mono);
    font-size: 0.75rem;
    color: var(--accent);
    font-weight: 600;
  }

  .visual-caption {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    margin-top: 12px;
    font-family: var(--ff-mono);
    font-size: 0.72rem;
    color: var(--muted);
  }

  .caption-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent);
  }

  @media (min-width: 1024px) {
    .hero-visual-container {
      max-width: 470px;
    }
    .card-api,
    .card-chat {
      transition: transform var(--transition-base), border-color var(--transition-base);
    }
    .hero-visual-container:hover .card-api {
      transform: translateY(-2px);
      border-color: var(--accent-border);
    }
    .hero-visual-container:hover .card-chat {
      transform: translateY(-2px);
      border-color: var(--accent-border);
    }
  }
</style>
