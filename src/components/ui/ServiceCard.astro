---
import Icon from './Icon.astro';

interface Props {
  icon?: string;
  title: string;
  description: string;
  ctaLabel?: string;
  ctaUrl?: string;
  slug?: string;
  class?: string;
}

const {
  icon = 'build',
  title,
  description,
  ctaLabel,
  ctaUrl,
  slug,
  class: className = '',
} = Astro.props;

// If a slug exists, link to detail page /services/${slug}, else ctaUrl if provided
const targetUrl = slug ? `/services/${slug}` : ctaUrl;
const isClickable = Boolean(targetUrl);
const resolvedCtaLabel = ctaLabel || (slug ? 'Learn more' : '');
---

<div class={`service-card ${isClickable ? 'service-card-link' : ''} ${className}`}>
  <div class="service-icon-wrap" aria-hidden="true">
    <Icon name={icon} size={28} />
  </div>
  <h3 class="service-title">{title}</h3>
  <p class="service-desc">{description}</p>
  {
    isClickable && resolvedCtaLabel && (
      <a href={targetUrl} class="service-cta">
        <span>{resolvedCtaLabel}</span>
        <span class="service-cta-arrow" aria-hidden="true">→</span>
      </a>
    )
  }
</div>

<style>
  .service-card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    padding: var(--sp-6);
    display: flex;
    flex-direction: column;
    position: relative;
    box-shadow: var(--shadow-card);
    transition: transform var(--transition-base), border-color var(--transition-base), background-color var(--transition-base), box-shadow var(--transition-base);
  }

  .service-card:hover {
    border-color: var(--accent-border);
    background: var(--card-hover);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .service-icon-wrap {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-btn);
    background: var(--accent-subtle);
    color: var(--accent);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--sp-4);
    border: 1px solid var(--accent-border);
    transition: background var(--transition-fast), color var(--transition-fast);
  }

  .service-card:hover .service-icon-wrap {
    background: var(--accent);
    color: var(--text-on-accent);
  }

  .service-title {
    font-family: var(--ff-sans);
    font-size: var(--fs-lg);
    font-weight: 700;
    color: var(--heading);
    letter-spacing: -0.01em;
    margin-bottom: var(--sp-2);
    line-height: 1.25;
  }

  .service-desc {
    font-family: var(--ff-sans);
    font-size: var(--fs-sm);
    color: var(--muted);
    line-height: 1.6;
    margin-bottom: var(--sp-4);
    flex-grow: 1;
  }

  .service-cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--ff-sans);
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--accent);
    text-decoration: none;
    transition: gap var(--transition-fast), color var(--transition-fast);
  }

  .service-cta:hover {
    color: var(--accent-hover);
    gap: 9px;
  }

  .service-cta-arrow {
    display: inline-block;
    transition: transform var(--transition-fast);
  }

  .service-cta:hover .service-cta-arrow {
    transform: translateX(2px);
  }

  @media (prefers-reduced-motion: reduce) {
    .service-card:hover {
      transform: none;
    }
  }
</style>
