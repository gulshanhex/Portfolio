---
import '../styles/tokens.css';
import '../styles/global.css';
import { t } from '../lib/ui-strings';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  canonical?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  robots?: string;
  authorName?: string;
  defaultTheme?: string;
  accent?: string;
  glowIntensity?: string;
  jsonLd?: Record<string, any> | null;
  settings?: Record<string, any>;
}

const {
  title = 'Your Name — Automation & AI Systems Engineer',
  description = 'Official portfolio specializing in Python backends, automation bots, PLC industrial automation, and Cloudflare edge systems.',
  keywords = 'Automation Engineer, AI Systems Engineer, Python Developer, Bot Developer, PLC Systems, Industrial Automation, Cloudflare Workers',
  canonical = 'https://portfolio.example.com',
  ogTitle = title,
  ogDescription = description,
  ogImage = 'https://portfolio.example.com/og-image.png',
  robots = 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1',
  authorName = 'Your Name',
  defaultTheme = 'dark',
  accent = 'emerald',
  glowIntensity = 'subtle',
  jsonLd = null,
  settings = {},
} = Astro.props;

const cleanCanonical = canonical.replace(/\/$/, '') || 'https://portfolio.example.com';
const resolvedOgImage = ogImage
  ? ogImage.startsWith('http')
    ? ogImage
    : `${cleanCanonical}${ogImage.startsWith('/') ? '' : '/'}${ogImage}`
  : `${cleanCanonical}/og-image.png`;

const siteName = settings?.global?.site_name || `${authorName} Portfolio`;
const firstName = authorName.split(' ')[0] || authorName;
const lastName = authorName.split(' ').slice(1).join(' ') || '';
const skipLabel = t(settings, 'a11y.skip_link');
const llmsSummaryTitle = t(settings, 'a11y.llms_summary_title');
const llmsFullTitle = t(settings, 'a11y.llms_full_title');
---

<!DOCTYPE html>
<html lang="en" data-theme={defaultTheme} data-accent={accent} data-glow={glowIntensity}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />

    <!-- Primary SEO Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content={authorName} />
    <meta name="creator" content={authorName} />
    <meta name="publisher" content={authorName} />
    <meta name="robots" content={robots} />
    <meta name="googlebot" content={robots} />
    <link rel="canonical" href={cleanCanonical} />

    <!-- LLM Context Profiles -->
    <link rel="alternate" type="text/markdown" href="/llms.txt" title={llmsSummaryTitle} />
    <link rel="alternate" type="text/markdown" href="/llms-full.txt" title={llmsFullTitle} />

    <!-- Favicons & PWA Manifest -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="16x16 32x32 48x48 64x64" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0A0C0B" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#F6F7F4" media="(prefers-color-scheme: light)" />
    <meta name="color-scheme" content="dark light" />

    <!-- OpenGraph / Social Meta Tags -->
    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={cleanCanonical} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:image:secure_url" content={resolvedOgImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogTitle} />
    <meta property="profile:first_name" content={firstName} />
    {lastName && <meta property="profile:last_name" content={lastName} />}

    <!-- Twitter / X Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={cleanCanonical} />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={resolvedOgImage} />
    <meta name="twitter:image:alt" content={ogTitle} />

    <!-- Preload Critical Self-Hosted Variable Font -->
    <link rel="preload" href="/fonts/inter-variable.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Early Theme Detection & Progressive Enhancement Bootstrap -->
    <script is:inline define:vars={{ defaultTheme, accent, glowIntensity }}>
      (function () {
        try {
          document.documentElement.classList.add('js');
          var saved = localStorage.getItem('gk-theme');
          var theme = saved;
          if (!theme) {
            if (defaultTheme === 'system') {
              theme = (window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches) ? 'light' : 'dark';
            } else {
              theme = defaultTheme || 'dark';
            }
          }
          document.documentElement.setAttribute('data-theme', theme);
          if (accent) {
            document.documentElement.setAttribute('data-accent', accent);
          }
          if (glowIntensity) {
            document.documentElement.setAttribute('data-glow', glowIntensity);
          }
        } catch (e) {}
      })();
    </script>

    <!-- Schema.org JSON-LD @graph -->
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    <slot name="head" />
  </head>
  <body>
    <a href="#main-content" class="skip-link">{skipLabel}</a>
    <slot />
  </body>
</html>
